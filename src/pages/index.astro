---
import Layout from "../layouts/Layout.astro";
import SparkLink from "../components/SparkLink.astro";

// Portfolio strip — ordre MT → HJ → EF (HJ trop editorial vs hero video classique,
// on garde MT en ouverture jusqu'a avoir contenu video plus moderne).
// 3 photos gardent leur largeur elargie : Fiat jaune (MT), parallax HJ, arche pampa EF.
const portfolioImages = [
  // MT — Mariage élégant à la française, Château de Perron (8)
  // Ouverture sur l'orangerie avec fontaine (format landscape wide) pour poser
  // le domaine + casser la monotonie des portraits sur le reste du marquee.
  { src: "/images/projects/mt/parallax-manor.jpg", alt: "M+T — Orangerie avec fontaine devant",  w: 540 },
  { src: "/images/portfolio-strip/01_3e933860.jpg", alt: "M+T — Salle de réception, lustres",   w: 300 },
  { src: "/images/portfolio-strip/03_e633e2c6.jpg", alt: "M+T — Couple en costume sombre",       w: 300 },
  { src: "/images/portfolio-strip/05_41e5ab48.jpg", alt: "M+T — Mariée dans voiture vintage",    w: 360 },
  { src: "/images/portfolio-strip/07_dce575f9.jpg", alt: "M+T — Table dressée, roses blanches", w: 300 },
  { src: "/images/closing-bouquet-zoom.jpg",        alt: "M+T — Bouquet blanc zoome, format paysage",          w: 450 },
  { src: "/images/portfolio-strip/09_06a401f7.jpg", alt: "M+T — Invitée au chapeau blanc",       w: 300 },
  { src: "/images/portfolio-strip/10_990a1165.jpg", alt: "M+T — Église, allée centrale",         w: 300 },
  // HJ — Romantisme moderne, Domaine de Saint-Martin-de-Ronsac (7)
  // Table rect reception entre allee de ceremonie et plan de table. Apres
  // le plan de table : papeterie zoomee + miroir de bienvenue (meme ordre
  // que le strip Temps forts de /portfolio).
  { src: "/images/projects/hj/8f83eb72.jpg",         alt: "H+J — Façade du Domaine de Saint-Martin-de-Ronsac",    w: 300 },
  { src: "/images/projects/hj/parallax.jpg",         alt: "H+J — Bouquet et accessoires de la mariée",            w: 580 },
  { src: "/images/projects/hj/porte-alliance-ferme.jpg", alt: "H+J — Porte-alliance fermé, main de la mariée sur le couvercle sculpté", w: 300 },
  { src: "/images/projects/hj/salle-reception-1.jpg", alt: "H+J — Salle de réception vue large, baies ouvertes",   w: 450 },
  { src: "/images/projects/hj/2afc7804.jpg",         alt: "H+J — Table rectangulaire avec roses blanches",        w: 300 },
  { src: "/images/projects/hj/d6291217.jpg",         alt: "H+J — Table des mariés, gypsophile et roses blanches", w: 300 },
  { src: "/images/projects/hj/361a575e.jpg",         alt: "H+J — Plan de table signalétique",                     w: 300 },
  { src: "/images/projects/hj/a53c7583-zoom.jpg",    alt: "H+J — Papeterie de table avec 3 roses blanches",       w: 300 },
  { src: "/images/projects/hj/40627cb4.jpg",         alt: "H+J — Signalétique miroir de bienvenue",               w: 300 },
  // EF — Mariage minimaliste bohème-tropical, Domaine des Oiseaux Heureux (5)
  // Photo du Domaine des Oiseaux Heureux avec fontaine retiree : trop similaire
  // de l'Orangerie MT (pavillon + fontaine + palmiers) qui ouvre le marquee.
  { src: "/images/projects/ef/parallax.jpg",        alt: "E+F — Cérémonie extérieure avec arche et pampas",  w: 720 },
  { src: "/images/portfolio-strip/13_f97907ca.jpg", alt: "E+F — Mariée avec bouquet",                        w: 300 },
  { src: "/images/portfolio-strip/14_b88c2457.jpg", alt: "E+F — Composition pampa sur socle",                w: 300 },
  { src: "/images/projects/ef/salle-reception.jpg", alt: "E+F — Salle de réception vue en enfilade",         w: 450 },
  { src: "/images/portfolio-strip/17_f9bdf9b5.jpg", alt: "E+F — Dressage avec menu et carte merci",          w: 300 },
];

// Témoignages clients — la flèche du carrousel cycle à travers cette liste.
// Chaque avis a sa propre photo affichée à gauche, cliquable vers la page projet.
// Les quotes sont des extraits legaux (avec "(...)") des avis complets, disponibles
// sur mariages.net et sur la page projet correspondante.
const testimonials = [
  {
    quote: "Aritia nous a accompagné pendant plusieurs mois jusqu'au jour J, dans nos choix jusqu'aux moindres détails.<br /><br />Créative, disponible et très humaine, elle a contribué à la belle réussite de notre mariage&nbsp;!",
    author: "HANTA & JOHN-LOÏS",
    image: "/images/projects/hj/d9a3dc74.jpg",
    imageAlt: "Portrait du couple H+J, Aritia Design",
    href: "/portfolio/hj",
    keyPrefix: "home.testimonial.3",
  },
  {
    quote: "Aritia Design nous a accompagnés pour préparer la décoration de notre mariage. Faire parts, décoration sur place (fleurs, aménagements, tables...).<br /><br />Elle a parfaitement pris en compte nos souhaits, nos gouts et notre budget. Sa proposition alliait élégance et originalité. C'était parfait.<br /><br />Merci",
    author: "Mélodie & Thibault",
    image: "/images/testimonial.jpg",
    imageAlt: "Mariée vue d'en haut dans l'escalier",
    href: "/portfolio/mt",
    keyPrefix: "home.testimonial.1",
  },
  {
    quote: "Le résultat a largement dépassé nos attentes&nbsp;! De la papeterie aux compositions florales, en passant par la décoration de la cérémonie à la salle de réception, tout était magnifique.<br /><br />Nous recommandons les yeux fermés&nbsp;!",
    author: "ELITAH & FYDERANA",
    image: "/images/projects/ef/01ad1414.jpg",
    imageAlt: "Sortie des mariés sous une pluie de pétales",
    href: "/portfolio/ef",
    keyPrefix: "home.testimonial.2",
  },
];
---

<Layout
  title="Décoration mariage Toulouse, Haute-Garonne | Aritia Design"
  description="Basée à Toulouse, œuvrant en Haute-Garonne, Aritia Design conçoit la décoration de mariages et d'événements haut de gamme, alliant direction artistique, scénographie, design floral et papeterie fine."
  transparentHeader={true}
>
  {/* ───────────────────────── 1. HERO ───────────────────────── */}
  <section
    class="relative h-screen min-h-[640px] w-full overflow-hidden text-white bg-center bg-cover bg-no-repeat"
    style="background-image: url('/images/hero-poster.jpg');"
  >
    <video
      class="absolute inset-0 w-full h-full object-cover"
      autoplay
      muted
      loop
      playsinline
    >
      <source src="/videos/hero.mp4" type="video/mp4" />
    </video>
    <div class="absolute inset-0 bg-black/40"></div>

    <div class="relative h-full flex flex-col items-center justify-center md:justify-end text-center px-6 md:pb-[5%]">
      <h1 class="font-display font-normal text-white text-[22px] sm:text-[30px] md:text-[40px] leading-[1.4] md:leading-[52px] tracking-[0.03em] sm:tracking-[0.05em]" data-i18n="home.hero.title">
        DIRECTION ARTISTIQUE<br />
        DESIGN FLORAL<br class="md:hidden" />
        <span class="hidden md:inline-block mx-2 md:mx-3 align-middle text-white text-[14px] sm:text-[16px] md:text-[20px] relative top-[-3px] sm:top-[-4px] md:top-[-5px]">✦</span>
        SCÉNOGRAPHIE<br />
        CRÉATION <span class="font-italic-serif italic font-normal">de</span> PAPETERIE
      </h1>
      <p class="mt-14 md:mt-16 text-[12px] sm:text-[13px] md:text-[15px] tracking-[1.6px] sm:tracking-[2px] md:tracking-[2.25px] uppercase text-white/85" data-i18n="home.hero.subtitle">
        Créatrice d'univers pour mariages<br />
        &amp; événements d'exception
      </p>

    </div>
  </section>

  {/* ───────────────────────── 2. INTRO ───────────────────────── */}
  <section id="intro" class="bg-white py-14 md:py-28 px-6">
    <div class="mx-auto text-center max-w-[1100px]">
      <h2 class="font-display font-normal text-[1.55rem] sm:text-[2.4rem] md:text-[2.8rem] leading-tight tracking-wide" data-i18n="home.intro.h2">
        CRÉATRICE D’UNIVERS ÉVÉNEMENTIELS<br />HAUT DE GAMME
      </h2>
      <p class="mt-7 md:mt-14 text-[0.7rem] sm:text-[0.82rem] tracking-[0.14em] sm:tracking-[0.18em] uppercase leading-[2] text-[var(--color-ink-soft)]" data-i18n="home.intro.p">
        Aritia Design vous accompagne dans la conception<br class="hidden md:inline" />
        de mariages et événements sur-mesure, raffinés et authentiques.<br class="hidden md:inline" />
        À Toulouse, en Haute-Garonne et ses environs.
      </p>
    </div>
  </section>

  {/* ───────────────────────── 3. PORTFOLIO STRIP (marquee) ───────────────── */}
  <section class="bg-[#1a1a1a] text-white relative overflow-hidden pt-[70px] pb-[70px] md:pt-[110px] md:pb-[110px]">
    {/* solid side bands of the portfolio section — overlay on top of the marquee */}
    <div class="pointer-events-none absolute inset-y-0 left-0 w-6 md:w-[110px] bg-[#1a1a1a] z-20"></div>
    <div class="pointer-events-none absolute inset-y-0 right-0 w-6 md:w-[110px] bg-[#1a1a1a] z-20"></div>

    {/* big PORTFOLIO heading — anchored at top, just inside the left dark band */}
    <h2
      class="font-display font-normal text-white leading-none tracking-[0.01em]
             text-[40px] sm:text-[60px] md:text-[64px] lg:text-[88px]
             absolute z-30
             top-[41px] sm:top-[70px] md:top-[49px]
             left-1/2 -translate-x-1/2 md:left-[170px] md:translate-x-0
             select-none pointer-events-none"
      data-i18n="home.portfolio.label"
    >
      PORTFOLIO
    </h2>

    <div class="marquee relative w-full" data-marquee>
      <div class="marquee-track gap-[10px] md:gap-[20px] items-center">
        {[...portfolioImages, ...portfolioImages].map((img, i) => (
          <a
            href="/portfolio"
            class="shrink-0 block h-[200px] md:h-[480px] overflow-hidden bg-neutral-800 group"
            aria-label={img.alt}
            tabindex={i < portfolioImages.length ? 0 : -1}
            aria-hidden={i >= portfolioImages.length ? "true" : undefined}
          >
            <img
              src={img.src}
              alt={img.alt}
              loading="lazy"
              draggable="false"
              class="h-full w-auto transition-transform duration-700 group-hover:scale-105 select-none pointer-events-none"
            />
          </a>
        ))}
      </div>

      {/* Chevrons discrets sur les bords : hint que le marquee est navigable */}
      <button
        type="button"
        class="marquee-chevron marquee-chevron--left"
        aria-label="Photo précédente"
        data-marquee-prev
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="15 6 9 12 15 18" />
        </svg>
      </button>
      <button
        type="button"
        class="marquee-chevron marquee-chevron--right"
        aria-label="Photo suivante"
        data-marquee-next
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="9 6 15 12 9 18" />
        </svg>
      </button>
    </div>

    <script is:inline>
      (function () {
        const marquee = document.querySelector("[data-marquee]");
        if (!marquee) return;
        const track = marquee.querySelector(".marquee-track");
        if (!track) return;

        // Translate3d sur le track (GPU accelere) au lieu de scrollLeft sur le
        // container : scrollLeft iOS Safari jitter + arrondi integer + momentum
        // scrolling => animation saccadee sur mobile. Transform est composite,
        // zero layout, zero paint, lisse en 60 fps.
        // Vitesse en px/sec directement (pas en LOOP_SECONDS) pour que home et
        // portfolio aient la meme cadence visuelle quelle que soit la taille
        // des thumbnails. Preset equilibre : ~5-6s par image a l'ecran.
        const PX_PER_SEC = matchMedia("(max-width: 768px)").matches ? 100 : 130;
        let paused = false;
        let resumeTimer;
        let position = 0;             // current translate x (negatif ou 0)
        let lastTime = performance.now();

        function tick(now) {
          const dt = Math.min(now - lastTime, 100); // cap pour evite jump si tab cachee
          lastTime = now;
          if (!paused) {
            const half = track.scrollWidth / 2;
            if (half > 0) {
              position -= PX_PER_SEC * (dt / 1000);
              if (position <= -half) position += half;
              track.style.transform = `translate3d(${position}px, 0, 0)`;
            }
          }
          requestAnimationFrame(tick);
        }
        if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
          requestAnimationFrame((t) => { lastTime = t; tick(t); });
        }

        const pause = () => { paused = true; clearTimeout(resumeTimer); };
        const scheduleResume = (delay) => {
          clearTimeout(resumeTimer);
          resumeTimer = setTimeout(() => {
            lastTime = performance.now(); // reset dt pour ne pas jump a la reprise
            paused = false;
          }, delay);
        };

        // Desktop : pause sur hover, reprise immediate sur mouseleave.
        // Desktop : pause sur hover, drag libre a la souris (mousedown + move).
        // Si l'utilisateur quitte le marquee pendant un drag, on continue a
        // suivre le mouvement via window (sinon le drag se fige des que la
        // souris sort du container).
        let mouseDown = false;
        let mouseStartX = 0;
        let mouseDragStart = 0;
        let mouseDragged = false;

        marquee.addEventListener("mouseenter", pause);
        marquee.addEventListener("mouseleave", () => {
          if (mouseDown) return; // garde pause si drag en cours
          clearTimeout(resumeTimer);
          lastTime = performance.now();
          paused = false;
        });

        marquee.addEventListener("mousedown", (e) => {
          pause();
          mouseDown = true;
          mouseStartX = e.clientX;
          mouseDragStart = position;
          mouseDragged = false;
        });

        window.addEventListener("mousemove", (e) => {
          if (!mouseDown) return;
          const delta = e.clientX - mouseStartX;
          if (Math.abs(delta) > 5) mouseDragged = true;
          if (mouseDragged) {
            const half = track.scrollWidth / 2;
            position = mouseDragStart + delta;
            while (position <= -half) position += half;
            while (position > 0) position -= half;
            track.style.transform = `translate3d(${position}px, 0, 0)`;
          }
        });

        window.addEventListener("mouseup", () => {
          if (!mouseDown) return;
          mouseDown = false;
          scheduleResume(2000);
        });

        // Bloque la navigation /portfolio si c'etait un drag (pas un click).
        marquee.addEventListener("click", (e) => {
          if (mouseDragged) {
            e.preventDefault();
            e.stopPropagation();
            mouseDragged = false;
          }
        }, true);

        // Touch mobile : pause + drag libre horizontal avec wrap seamless.
        let touchStartX = 0;
        let dragStartPos = 0;
        let isDragging = false;

        marquee.addEventListener("touchstart", (e) => {
          pause();
          isDragging = true;
          touchStartX = e.touches[0].clientX;
          dragStartPos = position;
        }, { passive: true });

        marquee.addEventListener("touchmove", (e) => {
          if (!isDragging) return;
          const delta = e.touches[0].clientX - touchStartX;
          const half = track.scrollWidth / 2;
          position = dragStartPos + delta;
          // Wrap dans [-half, 0] pour boucle seamless meme en drag
          while (position <= -half) position += half;
          while (position > 0) position -= half;
          track.style.transform = `translate3d(${position}px, 0, 0)`;
        }, { passive: true });

        const endDrag = () => {
          isDragging = false;
          scheduleResume(2000);
        };
        marquee.addEventListener("touchend",    endDrag, { passive: true });
        marquee.addEventListener("touchcancel", endDrag, { passive: true });

        // Chevrons bords : shift d'une thumbnail (~ 1 photo) a chaque click.
        const STEP_MOBILE = 160;
        const STEP_DESKTOP = 380;
        const shiftBy = (dir) => {
          pause();
          const step = matchMedia("(max-width: 768px)").matches ? STEP_MOBILE : STEP_DESKTOP;
          const half = track.scrollWidth / 2;
          position += dir * step;
          while (position <= -half) position += half;
          while (position > 0) position -= half;
          track.style.transition = "transform 0.5s cubic-bezier(0.22, 0.61, 0.36, 1)";
          track.style.transform = `translate3d(${position}px, 0, 0)`;
          setTimeout(() => {
            track.style.transition = "";
          }, 500);
          scheduleResume(2500);
        };
        const prev = marquee.querySelector("[data-marquee-prev]");
        const next = marquee.querySelector("[data-marquee-next]");
        if (prev) prev.addEventListener("click", () => shiftBy(1));   // prev = recule = translate vers la droite
        if (next) next.addEventListener("click", () => shiftBy(-1));  // next = avance = translate vers la gauche
      })();
    </script>

    {/* VOIR GALLERY — bottom band, right edge aligned with the gallery's right edge */}
    <div class="absolute z-30 left-0 right-0 bottom-0 h-[60px] md:h-[110px] px-6 md:px-[110px] flex items-center justify-end">
      <SparkLink
        href="/portfolio"
        label="Voir Gallery"
        i18nKey="home.portfolio.cta"
        arrowClass="h-[22px] w-[22px] md:h-[37px] md:w-[37px]"
        class="!text-[12px] md:!text-[18px] !tracking-[0.18em] md:!tracking-[0.2em] !gap-2 md:!gap-3"
      />
    </div>
  </section>

  {/* ───────────────────────── 4. MÉTHODE DE TRAVAIL ───────────────────────── */}
  <section class="bg-white px-6 pt-16 pb-[200px] md:pt-[140px] md:pb-[260px] overflow-x-hidden">
    <div class="mx-auto max-w-[1200px] grid md:grid-cols-2 gap-14 md:gap-20 items-center w-full">
      <div class="relative order-2 md:order-1">
        <div class="h-[400px] md:h-[480px] bg-cream overflow-hidden">
          <img
            src="/images/methode.jpg"
            alt="Voiture de mariage orange ornée de fleurs blanches, Aritia Design"
            class="w-full h-full object-cover"
            onerror="this.style.background='linear-gradient(135deg,#e8d8c0,#c69d6a)';this.removeAttribute('src');"
          />
        </div>
        <p class="font-script text-[32px] md:text-[42px] lg:text-[50px] leading-[1.1] text-[var(--color-ink)] absolute right-2 md:-right-32 -bottom-[100px] md:-bottom-[145px] whitespace-nowrap rotate-[-10deg]" data-i18n="home.method.script">
          Transformez chaque<br />
          <span class="ml-10 md:ml-16">occasion en moment</span><br />
          <span class="ml-20 md:ml-32">d’exception</span>
        </p>
      </div>

      <div class="md:pl-6 text-center flex flex-col items-center order-1 md:order-2">
        <h2 class="font-display font-light text-[40px] sm:text-[44px] md:text-[48px] lg:text-[60px] leading-[1.1]" data-i18n="home.method.h2">
          MÉTHODE<br />
          <span class="font-italic-serif italic">de</span> TRAVAIL
        </h2>
        <p class="mt-8 text-[16px] leading-[1.9] text-[var(--color-ink-soft)] max-w-md" data-i18n="home.method.p">
          De la première inspiration au jour J, nous vous accompagnons avec
          sensibilité et exigence dans la création d'un univers qui vous
          ressemble&nbsp;– une approche sur-mesure, pensée pour faire
          naître la beauté et l'émotion.
        </p>
        <a
          href="/processus"
          class="inline-block mt-10 px-10 py-4 border border-[var(--color-ink)] text-[0.72rem] tracking-[0.32em] uppercase hover:bg-[var(--color-ink)] hover:text-white transition"
          data-i18n="home.method.cta"
        >
          Découvrir
        </a>
      </div>
    </div>
  </section>

  {/* ───────────────────────── 5. MARIAGE / OCCASION SPÉCIALE ───────────────────────── */}
  <section class="bg-[#1a1a1a] text-white py-28 md:py-36 px-6">
    <div class="mx-auto max-w-[1200px] grid md:grid-cols-2 gap-14 md:gap-20 items-center">
      <div class="md:order-1 order-2 text-center flex flex-col items-center">
        <h2 class="font-display font-light text-[36px] sm:text-[44px] md:text-[48px] lg:text-[60px] leading-[1.1]" data-i18n="home.mariage.h2">
          MARIAGE<br />
          <span class="font-italic-serif italic">Occasion Spéciale</span>
        </h2>
        <p class="mt-8 text-[16px] leading-[1.9] text-white/80 max-w-md" data-i18n="home.mariage.p">
          À travers une approche transversale mêlant design floral,
          scénographie immersive, papeterie personnalisée et identité
          visuelle, nous concevons à vos côtés un univers esthétique global,
          où chaque choix incarne avec exigence l'essence de votre histoire.
        </p>
        <a
          href="/services"
          class="inline-block mt-10 px-10 py-4 border border-white text-[0.72rem] tracking-[0.32em] uppercase hover:bg-white hover:text-[var(--color-ink)] transition"
          data-i18n="home.mariage.cta"
        >
          Explorer
        </a>
      </div>

      <div class="md:order-2 order-1 aspect-[4/3] overflow-hidden">
        <img
          src="/images/mariage.jpg"
          alt="Salle de réception de mariage avec tables dressées, Aritia Design"
          class="w-full h-full object-cover"
          onerror="this.style.background='linear-gradient(135deg,#3a3530,#1a1a1a)';this.removeAttribute('src');"
        />
      </div>
    </div>
  </section>

  {/* ───────────────────────── 6. MOSAÏQUE PHOTOS (desktop only) ───────────────────────── */}
  <section class="hidden md:block bg-white py-28 md:py-36 px-6">
    <div class="mx-auto max-w-[1100px] relative h-[600px] md:h-[720px]">
      {/* Gauche — petit format, positionné pour recouvrir le visage de l'homme dans la photo centrale */}
      <div class="absolute left-[5.5%] top-[4%] w-[28%] aspect-square overflow-hidden shadow-sm z-10">
        <img
          src="/images/collage-salon.jpg"
          alt="Salon de mariage classique avec lustre, Aritia Design"
          class="w-full h-full object-cover"
          onerror="this.style.background='linear-gradient(135deg,#d8c9b3,#a8896a)';this.removeAttribute('src');"
        />
      </div>
      {/* Centre — grande photo dominante (portrait) */}
      <div class="absolute left-[26%] top-0 w-[40%] aspect-[3/4] overflow-hidden shadow-sm z-0">
        <img
          src="/images/collage-personne.jpg"
          alt="Invitée de mariage au chapeau blanc, Aritia Design"
          class="w-full h-full object-cover"
          onerror="this.style.background='linear-gradient(135deg,#1f2a3a,#0e1828)';this.removeAttribute('src');"
        />
      </div>
      {/* Droite — format paysage, juste sous l'épaule de la femme, décalé à droite pour laisser voir le bouquet */}
      <div class="absolute right-[1%] top-[47%] w-[38%] aspect-[4/3] overflow-hidden shadow-sm z-10">
        <img
          src="/images/collage-lieu.jpg"
          alt="Domaine de réception de mariage avec fontaine, Aritia Design"
          class="w-full h-full object-cover"
          onerror="this.style.background='linear-gradient(135deg,#6a8d59,#3a5a40)';this.removeAttribute('src');"
        />
      </div>
    </div>
