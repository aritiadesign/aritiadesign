---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";

// Web3Forms access key — get yours at https://web3forms.com (free, unlimited)
const WEB3FORMS_KEY = "8de1adb6-676c-48db-8d77-490f7ee76c05";

// Show a thank-you state when ?sent=1 is in the URL (Web3Forms redirects here after submission)
const sent = Astro.url.searchParams.get("sent") === "1";
---

<Layout
  title="Contact | Décoration mariage Toulouse | Aritia Design"
  description="Contactez Aritia pour concevoir votre mariage ou événement sur-mesure à Toulouse, en Haute-Garonne. Réservez un premier échange pour partager votre vision."
  transparentHeader={true}
>
  <PageHero
    image="/images/contact-hero.jpg"
    imageMobile="/images/contact-hero-mobile.jpg"
    imageAlt="Plafond aux poutres, lieu de mariage Aritia Design"
    title="Contact"
    titleKey="contact.hero.title"
    subtitleHtml="Vous rêvez d'un mariage ou d'un événement <br />qui vous ressemble&nbsp;?"
    subtitleKey="contact.hero.subtitle"
  />

  {/* ───────────────────────── 2. FORM ───────────────────────── */}
  <section class="bg-white px-6 py-20 md:py-28">
    <div class="mx-auto max-w-[1200px] grid md:grid-cols-2 gap-12 md:gap-16">
      {/* left: image + NOTES — pushed below the form on mobile, Notes before image on mobile */}
      <div class="flex flex-col-reverse md:flex-col gap-8 order-2 md:order-1">
        <div class="aspect-[4/5] overflow-hidden">
          <img
            src="/images/contact-flower.jpg"
            alt="Gros plan fleurs rouges de mariage, Aritia Design"
            class="w-full h-full object-cover"
          />
        </div>
        <div class="bg-[#1a1a1a] text-white p-8 md:p-10">
          <p class="font-display tracking-[0.28em] uppercase text-[20px] md:text-[22px] text-white/65" data-i18n="contact.notes.label">Notes</p>
          <p class="mt-5 text-[14px] leading-[1.9] text-white/85" data-i18n="contact.notes.p1">
            Merci de remplir ce formulaire avec soin. Je reviendrai
            vers vous dans les 48 heures ouvrées afin de planifier un
            premier rendez-vous téléphonique, en visio ou en
            présentiel.
          </p>
          <p class="mt-5 text-[14px] leading-[1.9] text-white/85">
            <span data-i18n="contact.notes.p2">Vous pouvez aussi nous écrire directement à l'adresse
            suivante&nbsp;:</span>
            <a
              href="mailto:contact@aritiadesign.com"
              class="block mt-2 underline underline-offset-4 hover:opacity-70 transition"
            >contact@aritiadesign.com</a>
          </p>
        </div>
      </div>

      {/* right: form — first on mobile so Envoyer appears before the photo */}
      <div class="order-1 md:order-2">
        <h2 class="font-display text-[34px] md:text-[44px] lg:text-[60px] leading-[1.05] md:leading-[1] tracking-wide text-[var(--color-ink)]" data-i18n="contact.h2">
          FAISONS<br />CONNAISSANCE
        </h2>
        <p class="mt-6 md:mt-8 text-[13px] md:text-[14px] leading-[1.85] md:leading-[1.9] text-[var(--color-ink-soft)] max-w-md" data-i18n="contact.p">
          Votre projet mérite une attention toute particulière, un
          regard sensible, et une mise en scène à la hauteur de vos
          émotions. Je serais honorée de vous accompagner dans la
          création d'un univers qui vous ressemble.
        </p>

        {/* Form CTA — invites the visitor to fill in the form below */}
        <p class="mt-4 md:mt-5 text-[13px] md:text-[14px] leading-[1.85] text-[var(--color-ink-soft)] max-w-md" data-i18n="contact.p.form">
          Partagez-nous votre vision via le formulaire ci-dessous, chaque demande est étudiée avec soin.
        </p>

        {/* Brochure lead-in — offered just above the form for hesitant visitors */}
        <p class="mt-4 md:mt-5 text-[13px] md:text-[14px] leading-[1.85] italic text-[var(--color-ink-soft)] max-w-md" data-i18n="contact.brochure.lead">
          Une hésitation ? Prenez le temps de parcourir
          <a
            href="https://www.aritiadesign.com/brochure/"
            target="_blank"
            rel="noopener"
            class="not-italic underline underline-offset-4 hover:text-[#630713] transition"
          >notre brochure complète</a>
          avant de remplir notre formulaire.
        </p>

        {sent && (
          <div class="mt-10 p-6 bg-[#f7f5f1] border border-[var(--color-ink)]/10 text-[14px] leading-[1.9] text-[var(--color-ink-soft)]">
            <p class="font-display text-[20px] text-[var(--color-ink)] mb-2" data-i18n="contact.thanks.h">Merci&nbsp;!</p>
            <p data-i18n="contact.thanks.p">Votre demande a bien été envoyée. Je reviens vers vous sous 48&nbsp;h ouvrées.</p>
          </div>
        )}

        <form
          action="https://api.web3forms.com/submit"
          method="POST"
          class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-6"
        >
          <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
          <input type="hidden" name="subject" value="Nouveau message — Aritia Design" />
          <input type="hidden" name="from_name" value="Site Aritia Design" />
          <input type="hidden" name="redirect" value={new URL("/contact?sent=1", Astro.site ?? Astro.url).toString()} />
          {/* Honeypot — bots fill this, real users don't */}
          <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />
          <div class="required-field border-b border-black/15 pb-1">
            <label class="sr-only" for="f-lastname" data-i18n="contact.label.lastname">Nom</label>
            <span class="fake-placeholder" aria-hidden="true">
              <span data-i18n="contact.ph.lastname">NOM</span><span class="req-marker">*</span>
            </span>
            <input
              id="f-lastname"
              type="text"
              name="Nom"
              required
              autocomplete="family-name"
              class="w-full bg-transparent text-[13px] md:text-[14px] tracking-[0.02em] text-[var(--color-ink)] focus:outline-none py-3"
            />
          </div>
          <div class="required-field border-b border-black/15 pb-1">
            <label class="sr-only" for="f-firstname" data-i18n="contact.label.firstname">Prénom</label>
            <span class="fake-placeholder" aria-hidden="true">
              <span data-i18n="contact.ph.firstname">PRÉNOM</span><span class="req-marker">*</span>
            </span>
            <input
              id="f-firstname"
              type="text"
              name="Prénom"
              required
              autocomplete="given-name"
              class="w-full bg-transparent text-[13px] md:text-[14px] tracking-[0.02em] text-[var(--color-ink)] focus:outline-none py-3"
            />
          </div>
          <div class="required-field border-b border-black/15 pb-1">
            <label class="sr-only" for="f-email" data-i18n="contact.label.email">Email</label>
            <span class="fake-placeholder" aria-hidden="true">
              <span data-i18n="contact.ph.email">E-MAIL</span><span class="req-marker">*</span>
            </span>
            <input
              id="f-email"
              type="email"
              name="Email"
              required
              autocomplete="email"
              class="w-full bg-transparent text-[13px] md:text-[14px] tracking-[0.02em] text-[var(--color-ink)] focus:outline-none py-3"
            />
          </div>
          <div class="border-b border-black/15 pb-1 flex items-center">
            <label class="sr-only" for="f-phone" data-i18n="contact.label.phone">Téléphone</label>
            <span
              id="f-phone-prefix"
              class="flex items-center gap-2 max-w-0 opacity-0 overflow-hidden transition-all duration-200 pointer-events-none"
            >
              <select
                id="f-phone-country"
                aria-label="Indicatif pays"
                tabindex="-1"
                class="bg-transparent text-[10px] md:text-[11px] tracking-[0.15em] uppercase text-[var(--color-muted)] focus:outline-none py-3 pr-1 appearance-none cursor-pointer shrink-0"
              >
                <option value="+33" selected>FR</option>
                <option value="+32">BE</option>
                <option value="+41">CH</option>
                <option value="+352">LU</option>
                <option value="+377">MC</option>
                <option value="+44">UK</option>
                <option value="+1">US</option>
                <option value="+34">ES</option>
                <option value="+39">IT</option>
                <option value="+49">DE</option>
                <option value="+351">PT</option>
                <option value="+31">NL</option>
              </select>
              <span aria-hidden="true" class="text-[var(--color-muted)] text-[13px] md:text-[14px] shrink-0 select-none">|</span>
            </span>
            <input
              id="f-phone"
              type="tel"
              name="Téléphone"
              placeholder="TÉLÉPHONE"
              data-i18n-attr="placeholder:contact.ph.phone"
              class="flex-1 bg-transparent text-[13px] md:text-[14px] tracking-[0.02em] placeholder:text-[11px] md:placeholder:text-[12px] placeholder:tracking-[0.2em] md:placeholder:tracking-[0.22em] placeholder:uppercase placeholder-[var(--color-muted)] focus:outline-none py-3 pl-0 focus:pl-2 transition-[padding] duration-200"
            />
          </div>
          <div class="required-field date-field border-b border-black/15 pb-1 relative">
            <label class="sr-only" for="f-date" data-i18n="contact.label.date">Date</label>
            <span class="fake-placeholder" aria-hidden="true">
              <span data-i18n="contact.ph.date">DATE DE L'ÉVÉNEMENT</span><span class="req-marker">*</span>
            </span>
            <input
              id="f-date"
              type="text"
              name="Date"
              required
              readonly
              autocomplete="off"
              inputmode="none"
              class="w-full bg-transparent text-[13px] md:text-[14px] tracking-[0.02em] text-[var(--color-ink)] focus:outline-none py-3 cursor-pointer"
            />
            <div id="f-date-picker" class="date-picker" hidden>
              <div class="dp-header">
                <button type="button" class="dp-nav" data-nav="prev" aria-label="Mois précédent">‹</button>
                <span class="dp-title">
                  <select class="dp-select dp-month-select" data-dp-month aria-label="Mois"></select>
                  <select class="dp-select dp-year-select" data-dp-year aria-label="Année"></select>
                </span>
                <button type="button" class="dp-nav" data-nav="next" aria-label="Mois suivant">›</button>
              </div>
              <div class="dp-weekdays">
                <span>Lun</span><span>Mar</span><span>Mer</span><span>Jeu</span><span>Ven</span><span>Sam</span><span>Dim</span>
              </div>
              <div class="dp-days"></div>
            </div>
          </div>
          <div class="required-field border-b border-black/15 pb-1">
            <label class="sr-only" for="f-guests" data-i18n="contact.label.guests">Nombre d'invités</label>
            <span class="fake-placeholder" aria-hidden="true">
              <span data-i18n="contact.ph.guests">NOMBRE D'INVITÉS</span><span class="req-marker">*</span>
            </span>
            <input
              id="f-guests"
              type="number"
              name="Nombre d'invités"
              required
              min="1"
              inputmode="numeric"
              class="w-full bg-transparent text-[13px] md:text-[14px] tracking-[0.02em] text-[var(--color-ink)] focus:outline-none py-3"
            />
          </div>
          <div class="required-field md:col-span-2 border-b border-black/15 pb-1">
            <label class="sr-only" for="f-location" data-i18n="contact.label.location">Lieu</label>
            <span class="fake-placeholder" aria-hidden="true">
              <span data-i18n="contact.ph.loc">LIEU DE L'ÉVÉNEMENT</span><span class="req-marker">*</span>
            </span>
            <input
              id="f-location"
              type="text"
              name="Lieu"
              required
              autocomplete="off"
              class="w-full bg-transparent text-[13px] md:text-[14px] tracking-[0.02em] text-[var(--color-ink)] focus:outline-none py-3"
            />
            <ul id="f-location-dropdown" class="location-dropdown" role="listbox" aria-label="Suggestions d'adresses"></ul>
          </div>
          <div class="required-field border-b border-black/15 pb-1">
            <label class="sr-only" for="f-type" data-i18n="contact.label.type">Type d'événement</label>
            <span class="fake-placeholder" aria-hidden="true">
              <span data-i18n="contact.opt.type.placeholder">TYPE D'ÉVÉNEMENT</span><span class="req-marker">*</span>
            </span>
            <select
              id="f-type"
              name="Type"
              required
              class="form-select w-full bg-transparent focus:outline-none py-3 appearance-none"
            >
              <option value="" disabled selected></option>
              <option style="letter-spacing:0.15em" data-i18n="contact.opt.type.0">Mariage</option>
              <option style="letter-spacing:0.15em" data-i18n="contact.opt.type.1">Événement saisonnier</option>
              <option style="letter-spacing:0.15em" data-i18n="contact.opt.type.2">Événements privés</option>
              <option style="letter-spacing:0.15em" data-i18n="contact.opt.type.3">Anniversaire</option>
              <option style="letter-spacing:0.15em" data-i18n="contact.opt.type.4">Baby Shower</option>
              <option style="letter-spacing:0.15em" data-i18n="contact.opt.type.5">Autre</option>
            </select>
          </div>
          <div class="required-field border-b border-black/15 pb-1">
            <label class="sr-only" for="f-prestation" data-i18n="contact.label.service">Prestation</label>
            <span class="fake-placeholder fake-placeholder-optional" aria-hidden="true">
              <span data-i18n="contact.opt.service.placeholder">PRESTATION SOUHAITÉE</span>
            </span>
            <select
              id="f-prestation"
              name="Prestation"
              class="form-select w-full bg-transparent focus:outline-none py-3 appearance-none"
            >
              <option value="" disabled selected></option>
              <option style="letter-spacing:0.15em" data-i18n="contact.opt.service.0">L'Exception — Design intégral</option>
              <option style="letter-spacing:0.15em" data-i18n="contact.opt.service.1">Pack Atmosphère — Identité visuelle</option>
              <option style="letter-spacing:0.15em" data-i18n="contact.opt.service.2">Direction Artistique Seule</option>
              <option style="letter-spacing:0.15em" data-i18n="contact.opt.service.3">Papeterie Fine</option>
              <option style="letter-spacing:0.15em" data-i18n="contact.opt.service.4">Conception Florale</option>
              <option style="letter-spacing:0.15em" data-i18n="contact.opt.service.5">Décor &amp; Scénographie</option>
              <option style="letter-spacing:0.15em" data-i18n="contact.opt.service.6">Sur-mesure</option>
            </select>
          </div>
          <div class="required-field md:col-span-2 border-b border-black/15 pb-1">
            <label class="sr-only" for="f-desc" data-i18n="contact.label.desc">Description</label>
            <span class="fake-placeholder" aria-hidden="true">
              <span data-i18n="contact.ph.desc">DESCRIPTION</span><span class="req-marker">*</span>
            </span>
            <textarea
              id="f-desc"
              name="Description"
              required
              rows="4"
              class="w-full bg-transparent text-[14px] tracking-[0.02em] text-[var(--color-ink)] focus:outline-none py-3 resize-none"
            ></textarea>
          </div>

          <div class="md:col-span-2 pt-4 text-center">
            <button
              type="submit"
              class="font-script text-[34px] md:text-[42px] text-[var(--color-ink)] hover:opacity-70 transition leading-none"
              data-i18n="contact.submit"
            >
              Envoyer
            </button>
          </div>
        </form>
      </div>
    </div>
  </section>

  <script is:inline>
    /* Phone field — country selector prefills / rewrites the dial code prefix.
       The FR selector + "|" separator stay hidden until the input is focused
       or already has a value; on focus, if empty, prepend the selected dial
       code (e.g. "+33 "). On country change, swap the existing prefix for the
       new one, preserving the rest of the number the user typed. */
    (function () {
      var sel = document.getElementById("f-phone-country");
      var inp = document.getElementById("f-phone");
      var prefix = document.getElementById("f-phone-prefix");
      if (!sel || !inp || !prefix) return;

      function dial() { return sel.value; }
      function stripDial(v) {
        var m = v.match(/^\+\d+\s*(.*)$/);
        return m ? m[1] : v;
      }
      function showPrefix() {
        prefix.style.maxWidth = "120px";
        prefix.style.opacity = "1";
        prefix.style.pointerEvents = "auto";
      }
      function hidePrefix() {
        prefix.style.maxWidth = "0";
        prefix.style.opacity = "0";
        prefix.style.pointerEvents = "none";
      }

      inp.addEventListener("focus", function () {
        showPrefix();
        if (!this.value.trim()) this.value = dial() + " ";
      });

      inp.addEventListener("blur", function () {
        if (this.value.trim() === dial() || !this.value.trim()) {
          this.value = "";
          hidePrefix();
        }
      });

      sel.addEventListener("change", function () {
        var rest = stripDial(inp.value.trim());
        inp.value = (dial() + " " + rest).trim();
        inp.focus();
      });
    })();
  </script>

  <script is:inline>
    /* Custom date picker — replaces the native input[type=date] to avoid any
       auto-fill of today's date. Text input is readonly; clicking opens a
       lightweight calendar overlay. User picks a date -> we set the input
       value in dd/mm/yyyy format. */
    (function () {
      var input = document.getElementById("f-date");
      var picker = document.getElementById("f-date-picker");
      if (!input || !picker) return;

      var monthEl = picker.querySelector("[data-dp-month]");
      var yearEl = picker.querySelector("[data-dp-year]");
      var daysEl = picker.querySelector(".dp-days");
      var prevBtn = picker.querySelector('[data-nav="prev"]');
      var nextBtn = picker.querySelector('[data-nav="next"]');

      var monthNames = ["Janvier","Février","Mars","Avril","Mai","Juin",
                        "Juillet","Août","Septembre","Octobre","Novembre","Décembre"];

      var today = new Date();
      today.setHours(0, 0, 0, 0);
      var viewMonth = today.getMonth();
      var viewYear = today.getFullYear();
      var selected = null;

      // Populate month + year selects once
      var monthsHtml = "";
      for (var mi = 0; mi < 12; mi++) monthsHtml += '<option value="' + mi + '">' + monthNames[mi] + '</option>';
      monthEl.innerHTML = monthsHtml;

      var yearMin = today.getFullYear();
      var yearMax = today.getFullYear() + 2;
      var yearsHtml = "";
      for (var yi = yearMin; yi <= yearMax; yi++) yearsHtml += '<option value="' + yi + '">' + yi + '</option>';
      yearEl.innerHTML = yearsHtml;

      monthEl.addEventListener("change", function () {
        viewMonth = parseInt(this.value, 10);
        render();
      });
      yearEl.addEventListener("change", function () {
        viewYear = parseInt(this.value, 10);
        render();
      });

      function pad2(n) { return n < 10 ? "0" + n : "" + n; }
      function isoDate(y, m, d) { return y + "-" + pad2(m + 1) + "-" + pad2(d); }
      function frDate(y, m, d) { return pad2(d) + "/" + pad2(m + 1) + "/" + y; }
      function isoOf(dateObj) { return isoDate(dateObj.getFullYear(), dateObj.getMonth(), dateObj.getDate()); }

      function render() {
        monthEl.value = String(viewMonth);
        yearEl.value = String(viewYear);

        // Monday-first week: shift Sunday(0) to end
        var firstOfMonth = new Date(viewYear, viewMonth, 1);
        var startWeekday = (firstOfMonth.getDay() + 6) % 7; // 0 = Monday
        var daysInMonth = new Date(viewYear, viewMonth + 1, 0).getDate();
        var daysInPrev = new Date(viewYear, viewMonth, 0).getDate();
        var todayIso = isoOf(today);

        var html = "";
        // Previous month tail
        for (var i = startWeekday - 1; i >= 0; i--) {
          html += '<button type="button" class="dp-day dp-other-month" disabled tabindex="-1">' +
                  (daysInPrev - i) + '</button>';
        }
        // Current month
        for (var d = 1; d <= daysInMonth; d++) {
          var iso = isoDate(viewYear, viewMonth, d);
          var classes = "dp-day";
          if (iso === todayIso) classes += " dp-today";
          if (iso === selected) classes += " dp-selected";
          html += '<button type="button" class="' + classes + '" data-date="' + iso + '">' + d + '</button>';
        }
        // Next month head to fill the last row
        var totalCells = startWeekday + daysInMonth;
        var trailing = (7 - (totalCells % 7)) % 7;
        for (var n = 1; n <= trailing; n++) {
          html += '<button type="button" class="dp-day dp-other-month" disabled tabindex="-1">' + n + '</button>';
        }
        daysEl.innerHTML = html;
      }

      function open() {
        if (selected) {
          var parts = selected.split("-");
          viewYear = parseInt(parts[0], 10);
          viewMonth = parseInt(parts[1], 10) - 1;
        } else {
          viewMonth = today.getMonth();
          viewYear = today.getFullYear();
        }
        picker.hidden = false;
        render();
      }
      function close() { picker.hidden = true; }

      /* Open on either focus or click. NEVER toggle-close here — otherwise
         the sequence 'focus opens -> click sees it open -> click closes'
         made the picker flash away on the first tap. Close is handled by
         picking a date, Escape, or clicking outside. */
      input.addEventListener("focus", function () {
        if (picker.hidden) open();
      });
      input.addEventListener("mousedown", function (e) {
        e.preventDefault(); // keep focus behavior deterministic
        if (picker.hidden) open();
      });

      prevBtn.addEventListener("click", function () {
        viewMonth--;
        if (viewMonth < 0) { viewMonth = 11; viewYear--; }
        render();
      });
      nextBtn.addEventListener("click", function () {
        viewMonth++;
        if (viewMonth > 11) { viewMonth = 0; viewYear++; }
        render();
      });

      daysEl.addEventListener("click", function (e) {
        var btn = e.target.closest(".dp-day[data-date]");
        if (!btn) return;
        selected = btn.dataset.date;
        var parts = selected.split("-");
        input.value = frDate(parseInt(parts[0], 10), parseInt(parts[1], 10) - 1, parseInt(parts[2], 10));
        input.dispatchEvent(new Event("input", { bubbles: true }));
        input.dispatchEvent(new Event("change", { bubbles: true }));
        close();
      });

      document.addEventListener("click", function (e) {
        if (!input.contains(e.target) && !picker.contains(e.target)) close();
      });
      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape" && !picker.hidden) close();
      });
    })();
  </script>

  <script is:inline>
    /* Prestation options depend on Type d'evenement — all fixed formulas
       and single-service packs (indexes 0-5) are wedding-only. For any
       non-wedding type (Saisonnier, Prives, Anniversaire, Baby Shower,
       Autre), those 6 options are disabled and 'Sur-mesure' (index 6)
       is auto-selected — whether the Prestation was empty or previously
       held a wedding formula. For Mariage or empty Type, all 7 options
       are enabled and the previous selection is preserved. */
    (function () {
      var typeSel = document.getElementById("f-type");
      var prestSel = document.getElementById("f-prestation");
      if (!typeSel || !prestSel) return;

      // Indexes of the wedding-only options — all except 'Sur-mesure' (6)
      var weddingOnly = [0, 1, 2, 3, 4, 5];
      var surMesureOpt = prestSel.querySelector('option[data-i18n="contact.opt.service.6"]');

      function syncPrestation() {
        var isNonWedding = typeSel.value !== "" && typeSel.value !== "Mariage";
        var options = prestSel.querySelectorAll("option[data-i18n]");
        options.forEach(function (opt) {
          var key = opt.getAttribute("data-i18n") || "";
          var m = key.match(/service\.(\d+)$/);
          if (!m) return;
          var idx = parseInt(m[1], 10);
          if (weddingOnly.indexOf(idx) !== -1) {
            opt.disabled = isNonWedding;
            opt.style.color = isNonWedding ? "rgba(28,28,28,0.3)" : "";
          }
        });
        // Auto-select Sur-mesure for any non-wedding type — whether the
        // field was empty or held a formula that just got disabled.
        if (isNonWedding && surMesureOpt && prestSel.value !== surMesureOpt.value) {
          surMesureOpt.selected = true;
          prestSel.dispatchEvent(new Event("change", { bubbles: true }));
        }
      }

      typeSel.addEventListener("change", syncPrestation);
      syncPrestation();
    })();
  </script>

  <script is:inline>
    /* Required-field fake-placeholder — toggle .has-value on wrappers so the
       overlay label + coloured * hide as soon as the user types / selects. */
    (function () {
      document.querySelectorAll(".required-field").forEach(function (field) {
        var el = field.querySelector("input, textarea, select");
        if (!el) return;
        function update() {
          var v = (el.value || "").trim();
          field.classList.toggle("has-value", v.length > 0);
        }
        el.addEventListener("input", update);
        el.addEventListener("change", update);
        el.addEventListener("blur", update);
        update();
      });
    })();
  </script>

  <script is:inline>
    /* Location field — French address autocomplete backed by BAN
       (Base Adresse Nationale, https://api-adresse.data.gouv.fr). Free,
       no key, purpose-built for type-ahead on French addresses. Returns
       a pre-formatted 'label' like "10 Rue du Capitole 31000 Toulouse"
       plus a 'context' with department + region — we compose them so the
       suggestion reads as a continuation of what the visitor typed. */
    (function () {
      var input = document.getElementById("f-location");
      var dropdown = document.getElementById("f-location-dropdown");
      if (!input || !dropdown) return;

      var timer;
      var lastQuery = "";
      var activeIndex = -1;
      var items = [];
      var isSelecting = false;
      var currentReqId = 0;

      function open() { dropdown.setAttribute("data-open", "true"); }
      function close() {
        dropdown.setAttribute("data-open", "false");
        activeIndex = -1;
      }

      function labelOf(feature) {
        var p = feature.properties || {};
        // p.label ex: "10 Rue du Capitole 31000 Toulouse"
        // p.context ex: "31, Haute-Garonne, Occitanie"
        var label = p.label || p.name || "";
        var ctx = p.context || "";
        // Keep only the departement name (middle part after the code)
        var dept = "";
        if (ctx) {
          var parts = ctx.split(",");
          dept = (parts.length >= 2 ? parts[1] : parts[0]).trim();
        }
        return dept ? (label + ", " + dept) : label;
      }

      function render(features) {
        items = features;
        activeIndex = -1;
        if (!features.length) { close(); return; }
        var html = "";
        for (var i = 0; i < features.length; i++) {
          var label = labelOf(features[i]);
          if (label) {
            html += '<li role="option" data-idx="' + i + '">' +
                    label.replace(/</g, "&lt;") +
                    '</li>';
          }
        }
        dropdown.innerHTML = html;
        open();
      }

      function fetchSuggestions(q) {
        currentReqId++;
        var reqId = currentReqId;
        var url = "https://api-adresse.data.gouv.fr/search/" +
                  "?limit=6&autocomplete=1" +
                  "&q=" + encodeURIComponent(q);
        fetch(url, { headers: { "Accept": "application/json" } })
          .then(function (r) { return r.ok ? r.json() : { features: [] }; })
          .then(function (data) {
            // Ignore stale responses (user has typed more since we sent this)
            if (reqId !== currentReqId) return;
            if (input.value.trim() !== q) return;
            render((data && data.features) || []);
          })
          .catch(function () {});
      }

      input.addEventListener("input", function () {
        if (isSelecting) return;
        var q = input.value.trim();
        clearTimeout(timer);
        if (q.length < 2) { close(); return; }
        if (q === lastQuery) return;
        // Debounce short — feels near-instant while staying under Nominatim's
        // 1 req/sec fair-use policy for realistic typing speeds
        timer = setTimeout(function () {
          lastQuery = q;
          fetchSuggestions(q);
        }, 200);
      });

      dropdown.addEventListener("mousedown", function (e) {
        var li = e.target.closest("li");
        if (!li) return;
        e.preventDefault();
        var idx = parseInt(li.dataset.idx, 10);
        if (isNaN(idx) || !items[idx]) return;
        // Flag prevents the dispatched input event from re-triggering a fetch
        isSelecting = true;
        input.value = labelOf(items[idx]);
        lastQuery = input.value.trim();
        input.dispatchEvent(new Event("input", { bubbles: true }));
        input.dispatchEvent(new Event("change", { bubbles: true }));
        isSelecting = false;
        close();
      });

      input.addEventListener("keydown", function (e) {
        if (dropdown.getAttribute("data-open") !== "true") return;
        var lis = dropdown.querySelectorAll("li");
        if (e.key === "ArrowDown") {
          e.preventDefault();
          activeIndex = Math.min(activeIndex + 1, lis.length - 1);
        } else if (e.key === "ArrowUp") {
          e.preventDefault();
          activeIndex = Math.max(activeIndex - 1, 0);
        } else if (e.key === "Enter" && activeIndex >= 0) {
          e.preventDefault();
          lis[activeIndex].dispatchEvent(new MouseEvent("mousedown", { bubbles: true }));
          return;
        } else if (e.key === "Escape") {
          close();
          return;
        } else {
          return;
        }
        lis.forEach(function (li, i) {
          li.setAttribute("data-active", i === activeIndex ? "true" : "false");
        });
      });

      document.addEventListener("click", function (e) {
        if (!input.contains(e.target) && !dropdown.contains(e.target)) close();
      });

      input.addEventListener("blur", function () {
        setTimeout(close, 150);
      });
    })();
  </script>
</Layout>
