  <script is:inline>
    /* Phone field — country selector prefills / rewrites the dial code prefix.
       The FR selector + "|" separator stay hidden until the input is focused
       or already has a value; on focus, if empty, prepend the selected dial
       code (e.g. "+33 "). On country change, swap the existing prefix for the
       new one, preserving the rest of the number the user typed. */
    (function () {
      var sel = document.getElementById("f-phone-country");
      var inp = document.getElementById("f-phone");
      var prefix = document.getElementById("f-phone-prefix");
      if (!sel || !inp || !prefix) return;

      function dial() { return sel.value; }
      function stripDial(v) {
        var m = v.match(/^\+\d+\s*(.*)$/);
        return m ? m[1] : v;
      }
      function showPrefix() {
        prefix.style.maxWidth = "120px";
        prefix.style.opacity = "1";
        prefix.style.pointerEvents = "auto";
      }
      function hidePrefix() {
        prefix.style.maxWidth = "0";
        prefix.style.opacity = "0";
        prefix.style.pointerEvents = "none";
      }

      inp.addEventListener("focus", function () {
        showPrefix();
        if (!this.value.trim()) this.value = dial() + " ";
      });

      inp.addEventListener("blur", function () {
        if (this.value.trim() === dial() || !this.value.trim()) {
          this.value = "";
          hidePrefix();
        }
      });

      sel.addEventListener("change", function () {
        var rest = stripDial(inp.value.trim());
        inp.value = (dial() + " " + rest).trim();
        inp.focus();
      });
    })();
  </script>

  <script is:inline>
    /* Custom date picker — replaces the native input[type=date] to avoid any
       auto-fill of today's date. Text input is readonly; clicking opens a
       lightweight calendar overlay. User picks a date -> we set the input
       value in dd/mm/yyyy format. */
    (function () {
      var input = document.getElementById("f-date");
      var picker = document.getElementById("f-date-picker");
      if (!input || !picker) return;

      var monthEl = picker.querySelector("[data-dp-month]");
      var yearEl = picker.querySelector("[data-dp-year]");
      var daysEl = picker.querySelector(".dp-days");
      var prevBtn = picker.querySelector('[data-nav="prev"]');
      var nextBtn = picker.querySelector('[data-nav="next"]');

      var monthNames = ["Janvier","Février","Mars","Avril","Mai","Juin",
                        "Juillet","Août","Septembre","Octobre","Novembre","Décembre"];

      var today = new Date();
      today.setHours(0, 0, 0, 0);
      var viewMonth = today.getMonth();
      var viewYear = today.getFullYear();
      var selected = null;

      // Populate month + year selects once
      var monthsHtml = "";
      for (var mi = 0; mi < 12; mi++) monthsHtml += '<option value="' + mi + '">' + monthNames[mi] + '</option>';
      monthEl.innerHTML = monthsHtml;

      var yearMin = today.getFullYear();
      var yearMax = today.getFullYear() + 2;
      var yearsHtml = "";
      for (var yi = yearMin; yi <= yearMax; yi++) yearsHtml += '<option value="' + yi + '">' + yi + '</option>';
      yearEl.innerHTML = yearsHtml;

      monthEl.addEventListener("change", function () {
        viewMonth = parseInt(this.value, 10);
        render();
      });
      yearEl.addEventListener("change", function () {
        viewYear = parseInt(this.value, 10);
        render();
      });

      function pad2(n) { return n < 10 ? "0" + n : "" + n; }
      function isoDate(y, m, d) { return y + "-" + pad2(m + 1) + "-" + pad2(d); }
      function frDate(y, m, d) { return pad2(d) + "/" + pad2(m + 1) + "/" + y; }
      function isoOf(dateObj) { return isoDate(dateObj.getFullYear(), dateObj.getMonth(), dateObj.getDate()); }

      function render() {
        monthEl.value = String(viewMonth);
        yearEl.value = String(viewYear);

        // Monday-first week: shift Sunday(0) to end
        var firstOfMonth = new Date(viewYear, viewMonth, 1);
        var startWeekday = (firstOfMonth.getDay() + 6) % 7; // 0 = Monday
        var daysInMonth = new Date(viewYear, viewMonth + 1, 0).getDate();
        var daysInPrev = new Date(viewYear, viewMonth, 0).getDate();
        var todayIso = isoOf(today);

        var html = "";
        // Previous month tail
        for (var i = startWeekday - 1; i >= 0; i--) {
          html += '<button type="button" class="dp-day dp-other-month" disabled tabindex="-1">' +
                  (daysInPrev - i) + '</button>';
        }
        // Current month
        for (var d = 1; d <= daysInMonth; d++) {
          var iso = isoDate(viewYear, viewMonth, d);
          var classes = "dp-day";
          if (iso === todayIso) classes += " dp-today";
          if (iso === selected) classes += " dp-selected";
          html += '<button type="button" class="' + classes + '" data-date="' + iso + '">' + d + '</button>';
        }
        // Next month head to fill the last row
        var totalCells = startWeekday + daysInMonth;
        var trailing = (7 - (totalCells % 7)) % 7;
        for (var n = 1; n <= trailing; n++) {
          html += '<button type="button" class="dp-day dp-other-month" disabled tabindex="-1">' + n + '</button>';
        }
        daysEl.innerHTML = html;
      }

      function open() {
        if (selected) {
          var parts = selected.split("-");
          viewYear = parseInt(parts[0], 10);
          viewMonth = parseInt(parts[1], 10) - 1;
        } else {
          viewMonth = today.getMonth();
          viewYear = today.getFullYear();
        }
        picker.hidden = false;
        render();
      }
      function close() { picker.hidden = true; }

      /* Open on either focus or click. NEVER toggle-close here — otherwise
         the sequence 'focus opens -> click sees it open -> click closes'
         made the picker flash away on the first tap. Close is handled by
         picking a date, Escape, or clicking outside. */
      input.addEventListener("focus", function () {
        if (picker.hidden) open();
      });
      input.addEventListener("mousedown", function (e) {
        e.preventDefault(); // keep focus behavior deterministic
        if (picker.hidden) open();
      });

      prevBtn.addEventListener("click", function () {
        viewMonth--;
        if (viewMonth < 0) { viewMonth = 11; viewYear--; }
        render();
      });
      nextBtn.addEventListener("click", function () {
        viewMonth++;
        if (viewMonth > 11) { viewMonth = 0; viewYear++; }
        render();
      });

      daysEl.addEventListener("click", function (e) {
        var btn = e.target.closest(".dp-day[data-date]");
        if (!btn) return;
        selected = btn.dataset.date;
        var parts = selected.split("-");
        input.value = frDate(parseInt(parts[0], 10), parseInt(parts[1], 10) - 1, parseInt(parts[2], 10));
        input.dispatchEvent(new Event("input", { bubbles: true }));
        input.dispatchEvent(new Event("change", { bubbles: true }));
        close();
      });

      document.addEventListener("click", function (e) {
        if (!input.contains(e.target) && !picker.contains(e.target)) close();
      });
      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape" && !picker.hidden) close();
      });
    })();
  </script>

  <script is:inline>
    /* Prestation options depend on Type d'evenement — only the two full
       packages (L'Exception, index 0 and Pack Atmosphère, index 1) are
       wedding-only. For any non-wedding type (Saisonnier, Prives,
       Anniversaire, Baby Shower, Autre) those 2 options are disabled;
       the other 5 (Direction Artistique Seule, Papeterie Fine,
       Conception Florale, Décor & Scénographie, Sur-mesure) stay
       selectable. If the current selection becomes disabled, we auto-
       switch it to Sur-mesure to keep the form valid. */
    (function () {
      var typeSel = document.getElementById("f-type");
      var prestSel = document.getElementById("f-prestation");
      if (!typeSel || !prestSel) return;

      // Full packages — disabled for non-wedding events
      var weddingOnly = [0, 1];
      var surMesureOpt = prestSel.querySelector('option[data-i18n="contact.opt.service.6"]');

      function syncPrestation() {
        var isNonWedding = typeSel.value !== "" && typeSel.value !== "Mariage";
        var options = prestSel.querySelectorAll("option[data-i18n]");
        options.forEach(function (opt) {
          var key = opt.getAttribute("data-i18n") || "";
          var m = key.match(/service\.(\d+)$/);
          if (!m) return;
          var idx = parseInt(m[1], 10);
          if (weddingOnly.indexOf(idx) !== -1) {
            opt.disabled = isNonWedding;
            opt.style.color = isNonWedding ? "rgba(28,28,28,0.3)" : "";
          }
        });
        // If the current selection just became disabled, swap to Sur-mesure
        // so the form stays valid.
        var currentOpt = prestSel.options[prestSel.selectedIndex];
        if (isNonWedding && currentOpt && currentOpt.disabled && surMesureOpt) {
          surMesureOpt.selected = true;
          prestSel.dispatchEvent(new Event("change", { bubbles: true }));
        }
      }

      typeSel.addEventListener("change", syncPrestation);
      syncPrestation();
    })();
  </script>

  <script is:inline>
    /* Required-field fake-placeholder — toggle .has-value on wrappers so the
       overlay label + coloured * hide as soon as the user types / selects. */
    (function () {
      document.querySelectorAll(".required-field").forEach(function (field) {
        var el = field.querySelector("input, textarea, select");
        if (!el) return;
        function update() {
          var v = (el.value || "").trim();
          field.classList.toggle("has-value", v.length > 0);
        }
        el.addEventListener("input", update);
        el.addEventListener("change", update);
        el.addEventListener("blur", update);
        update();
      });
    })();
  </script>

  <script is:inline>
    /* Location field — French address autocomplete backed by BAN
       (Base Adresse Nationale, https://api-adresse.data.gouv.fr). Free,
       no key, purpose-built for type-ahead on French addresses. Returns
       a pre-formatted 'label' like "10 Rue du Capitole 31000 Toulouse"
       plus a 'context' with department + region — we compose them so the
       suggestion reads as a continuation of what the visitor typed. */
    (function () {
      var input = document.getElementById("f-location");
      var dropdown = document.getElementById("f-location-dropdown");
      if (!input || !dropdown) return;

      var timer;
      var lastQuery = "";
      var activeIndex = -1;
      var items = [];
      var isSelecting = false;
      var currentReqId = 0;

      function open() { dropdown.setAttribute("data-open", "true"); }
      function close() {
        dropdown.setAttribute("data-open", "false");
        activeIndex = -1;
      }

      function labelOf(feature) {
        var p = feature.properties || {};
        // p.label ex: "10 Rue du Capitole 31000 Toulouse"
        // p.context ex: "31, Haute-Garonne, Occitanie"
        var label = p.label || p.name || "";
        var ctx = p.context || "";
        // Keep only the departement name (middle part after the code)
        var dept = "";
        if (ctx) {
          var parts = ctx.split(",");
          dept = (parts.length >= 2 ? parts[1] : parts[0]).trim();
        }
        return dept ? (label + ", " + dept) : label;
      }

      function render(features) {
        items = features;
        activeIndex = -1;
        if (!features.length) { close(); return; }
        var html = "";
        for (var i = 0; i < features.length; i++) {
          var label = labelOf(features[i]);
          if (label) {
            html += '<li role="option" data-idx="' + i + '">' +
                    label.replace(/</g, "&lt;") +
                    '</li>';
          }
        }
        dropdown.innerHTML = html;
        open();
      }

      function fetchSuggestions(q) {
        currentReqId++;
        var reqId = currentReqId;
        var url = "https://api-adresse.data.gouv.fr/search/" +
                  "?limit=6&autocomplete=1" +
                  "&q=" + encodeURIComponent(q);
        fetch(url, { headers: { "Accept": "application/json" } })
          .then(function (r) { return r.ok ? r.json() : { features: [] }; })
          .then(function (data) {
            // Ignore stale responses (user has typed more since we sent this)
            if (reqId !== currentReqId) return;
            if (input.value.trim() !== q) return;
            render((data && data.features) || []);
          })
          .catch(function () {});
      }

      input.addEventListener("input", function () {
        if (isSelecting) return;
        var q = input.value.trim();
        clearTimeout(timer);
        if (q.length < 2) { close(); return; }
        if (q === lastQuery) return;
        // Debounce short — feels near-instant while staying under Nominatim's
        // 1 req/sec fair-use policy for realistic typing speeds
        timer = setTimeout(function () {
          lastQuery = q;
          fetchSuggestions(q);
        }, 200);
      });

      dropdown.addEventListener("mousedown", function (e) {
        var li = e.target.closest("li");
        if (!li) return;
        e.preventDefault();
        var idx = parseInt(li.dataset.idx, 10);
        if (isNaN(idx) || !items[idx]) return;
        // Flag prevents the dispatched input event from re-triggering a fetch
        isSelecting = true;
        input.value = labelOf(items[idx]);
        lastQuery = input.value.trim();
        input.dispatchEvent(new Event("input", { bubbles: true }));
        input.dispatchEvent(new Event("change", { bubbles: true }));
        isSelecting = false;
        close();
      });

      input.addEventListener("keydown", function (e) {
        if (dropdown.getAttribute("data-open") !== "true") return;
        var lis = dropdown.querySelectorAll("li");
        if (e.key === "ArrowDown") {
          e.preventDefault();
          activeIndex = Math.min(activeIndex + 1, lis.length - 1);
        } else if (e.key === "ArrowUp") {
          e.preventDefault();
          activeIndex = Math.max(activeIndex - 1, 0);
        } else if (e.key === "Enter" && activeIndex >= 0) {
          e.preventDefault();
          lis[activeIndex].dispatchEvent(new MouseEvent("mousedown", { bubbles: true }));
          return;
        } else if (e.key === "Escape") {
          close();
          return;
        } else {
          return;
        }
        lis.forEach(function (li, i) {
          li.setAttribute("data-active", i === activeIndex ? "true" : "false");
        });
      });

      document.addEventListener("click", function (e) {
        if (!input.contains(e.target) && !dropdown.contains(e.target)) close();
      });

      input.addEventListener("blur", function () {
        setTimeout(close, 150);
      });
    })();
  </script>

  <script is:inline>
    /* Custom dropdowns for Type + Prestation — the native <select> stays in
       the DOM (visually hidden via .sr-only) so the form still submits and
       the existing type/prestation sync logic keeps working. A readonly
       input + <ul> mirror its state and provide the styled panel matching
       the date-picker aesthetic. */
    (function () {
      function initDropdown(displayId, selectId, dropdownId) {
        var displayInput = document.getElementById(displayId);
        var selectEl = document.getElementById(selectId);
        var dropdown = document.getElementById(dropdownId);
        if (!displayInput || !selectEl || !dropdown) return;

        var activeIndex = -1;

        function open() {
          render();
          dropdown.hidden = false;
          dropdown.setAttribute("data-open", "true");
          displayInput.setAttribute("aria-expanded", "true");
        }
        function close() {
          dropdown.setAttribute("data-open", "false");
          dropdown.hidden = true;
          displayInput.setAttribute("aria-expanded", "false");
          activeIndex = -1;
        }

        function render() {
          var options = selectEl.querySelectorAll("option");
          var html = "";
          options.forEach(function (opt) {
            if (!opt.value) return; // skip disabled placeholder
            var i18n = opt.getAttribute("data-i18n") || "";
            var isDisabled = opt.disabled ? "true" : "false";
            var isSelected = opt.value === selectEl.value;
            var safeVal = opt.value.replace(/"/g, "&quot;");
            html +=
              '<li role="option" data-value="' + safeVal + '"' +
              ' data-disabled="' + isDisabled + '"' +
              (isSelected ? ' data-active="true"' : '') +
              (i18n ? ' data-i18n="' + i18n + '"' : '') +
              '>' + opt.textContent + '</li>';
          });
          dropdown.innerHTML = html;
        }

        function selectByValue(value) {
          var newOpt = selectEl.querySelector('option[value="' + value.replace(/"/g, '\\"') + '"]');
          if (!newOpt || newOpt.disabled) return;
          selectEl.value = value;
          displayInput.value = newOpt.textContent;
          selectEl.dispatchEvent(new Event("change", { bubbles: true }));
          // Update wrapper .has-value state for the fake-placeholder overlay
          var wrapper = displayInput.closest(".required-field");
          if (wrapper) wrapper.classList.toggle("has-value", displayInput.value.length > 0);
          close();
        }

        function updateDisplay() {
          var selectedOpt = selectEl.options[selectEl.selectedIndex];
          displayInput.value = selectedOpt && selectedOpt.value ? selectedOpt.textContent : "";
          var wrapper = displayInput.closest(".required-field");
          if (wrapper) wrapper.classList.toggle("has-value", displayInput.value.length > 0);
        }

        displayInput.addEventListener("mousedown", function (e) {
          e.preventDefault();
          if (dropdown.hidden) { open(); } else { close(); }
        });

        dropdown.addEventListener("mousedown", function (e) {
          e.preventDefault();
          var li = e.target.closest("li");
          if (!li) return;
          if (li.getAttribute("data-disabled") === "true") return;
          selectByValue(li.getAttribute("data-value"));
        });

        displayInput.addEventListener("keydown", function (e) {
          if (dropdown.hidden && ["ArrowDown","ArrowUp","Enter"," "].indexOf(e.key) !== -1) {
            e.preventDefault();
            open();
            return;
          }
          if (dropdown.hidden) return;
          var lis = Array.from(dropdown.querySelectorAll('li:not([data-disabled="true"])'));
          if (e.key === "ArrowDown") {
            e.preventDefault();
            activeIndex = Math.min(activeIndex + 1, lis.length - 1);
          } else if (e.key === "ArrowUp") {
            e.preventDefault();
            activeIndex = Math.max(activeIndex - 1, 0);
          } else if (e.key === "Enter" && activeIndex >= 0) {
            e.preventDefault();
            selectByValue(lis[activeIndex].getAttribute("data-value"));
            return;
          } else if (e.key === "Escape") {
            close();
            return;
          } else {
            return;
          }
          lis.forEach(function (li, i) {
            li.setAttribute("data-active", i === activeIndex ? "true" : "false");
          });
        });

        document.addEventListener("click", function (e) {
          if (!displayInput.contains(e.target) && !dropdown.contains(e.target)) close();
        });

        // Reflect programmatic changes (e.g. auto-select "Sur-mesure")
        selectEl.addEventListener("change", updateDisplay);
        updateDisplay();
      }

      initDropdown("f-type-display", "f-type", "f-type-dropdown");
      initDropdown("f-prestation-display", "f-prestation", "f-prestation-dropdown");
    })();
  </script>

  <script is:inline>
    /* Intercept form submission so we can surface a short error message
       under the Envoyer button if Web3Forms fails (network down, API
       error, etc.). On success we mirror the native redirect behaviour
       and navigate to /contact?sent=1 to show the "Merci" state. */
    (function () {
      var form = document.getElementById("f-contact");
      var submitBtn = form && form.querySelector('button[type="submit"]');
      if (!form || !submitBtn) return;

      function wrapperOf(el) {
        // For the custom dropdowns, the hidden <select> lives inside the same
        // .required-field as its display input — same wrapper either way.
        // Checkbox consent RGPD lives in .consent-field.
        return el.closest(".required-field") || el.closest(".consent-field");
      }

      // Clear the star as soon as the user gives the field content
      function bindClearOnEdit(wrapper) {
        if (!wrapper || wrapper.__errBound) return;
        wrapper.__errBound = true;
        var fields = wrapper.querySelectorAll("input, select, textarea");
        fields.forEach(function (f) {
          ["input", "change", "blur"].forEach(function (ev) {
            f.addEventListener(ev, function () {
              var ok = f.type === "checkbox" ? f.checked : !!(f.value || "").trim();
              if (ok) wrapper.classList.remove("has-error");
            });
          });
        });
      }

      // Custom validation — marks every invalid required field with .has-error
      // so the bordeaux 4-branch star appears next to its placeholder text.
      // Returns true when the whole form is valid.
      function validate() {
        var fields = form.querySelectorAll("input[required], select[required], textarea[required]");
        var firstInvalid = null;
        fields.forEach(function (f) {
          var value = (f.value || "").trim();
          var wrap = wrapperOf(f);
          var isInvalid;
          if (f.type === "checkbox") {
            isInvalid = !f.checked;
          } else {
            isInvalid = !value ||
              (f.type === "email" && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value));
          }
          if (wrap) {
            wrap.classList.toggle("has-error", isInvalid);
            bindClearOnEdit(wrap);
          }
          if (isInvalid && !firstInvalid) firstInvalid = f;
        });
        if (firstInvalid) {
          focusField(firstInvalid);
          return false;
        }
        return true;
      }

      function focusField(el) {
        if (el.id === "f-type") { var d = document.getElementById("f-type-display"); if (d) el = d; }
        if (el.id === "f-prestation") { var d2 = document.getElementById("f-prestation-display"); if (d2) el = d2; }
        try { el.focus(); } catch (_) {}
        try { el.scrollIntoView({ behavior: "smooth", block: "center" }); } catch (_) {}
      }

      function showSuccess() {
        submitBtn.innerHTML =
          '<span class="inline-block text-left leading-[0.95] rotate-[-11deg] origin-center">' +
            '<span class="block">Bien reçu,</span>' +
            '<span class="block pl-[0.9em]">à très vite&nbsp;!</span>' +
          '</span>';
        submitBtn.disabled = true;
        // Prevent re-submission by disabling all fields (visual state stays)
        form.querySelectorAll("input, select, textarea").forEach(function (el) {
          el.setAttribute("disabled", "");
        });
      }

      /* Fire-and-forget : POST vers le webhook Aritia Atelier pour creer automatiquement
         un prospect dans le CRM prive. Non bloquant pour l'experience utilisateur. */
      function pushToAtelier(data) {
        try {
          var ATELIER_URL = "https://aritia-atelier.vercel.app/api/prospect-webhook";
          var ATELIER_SECRET = "ar1t1a-s1te-pr0d-2026";
          var nom = (data.get("Nom") || "").trim();
          var prenom = (data.get("Prénom") || "").trim();
          var coupleName = prenom && nom ? (prenom + " " + nom) : (prenom || nom);
          var invitesRaw = (data.get("Nombre d'invités") || "").toString().trim();
          var invites = invitesRaw ? parseInt(invitesRaw.replace(/[^0-9]/g, ""), 10) || null : null;
          var payload = {
            couple: coupleName,
            email: (data.get("Email") || "").trim(),
            phone: (data.get("Téléphone") || "").trim() || null,
            type: (data.get("Type") || "Mariage").trim(),
            invites: invites,
            venue: (data.get("Lieu") || "").trim() || null,
            event_date: (data.get("Date") || "").trim() || null,
            brief: (data.get("Détails complémentaires") || "").trim() || null,
            source: "site-contact-form",
          };
          fetch(ATELIER_URL, {
            method: "POST",
            headers: { "Content-Type": "application/json", "X-Aritia-Webhook-Secret": ATELIER_SECRET },
            body: JSON.stringify(payload),
            keepalive: true,
          }).catch(function () { /* silencieux */ });
        } catch (_) { /* silencieux */ }
      }

      form.addEventListener("submit", function (e) {
        e.preventDefault();
        if (!validate()) return;

        submitBtn.disabled = true;
        var data = new FormData(form);
        fetch(form.action, { method: "POST", body: data })
          .then(function (res) { return res.json().catch(function () { return { success: res.ok }; }); })
          .then(function (json) {
            if (json && json.success) {
              pushToAtelier(data);
              showSuccess();
            } else {
              throw new Error((json && json.message) || "Send failed");
            }
          })
          .catch(function () {
            // Network / API failure — re-enable so the user can retry.
            submitBtn.disabled = false;
          });
      });
    })();
  </script>
