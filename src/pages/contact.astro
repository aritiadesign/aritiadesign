---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";

// Web3Forms access key — get yours at https://web3forms.com (free, unlimited)
const WEB3FORMS_KEY = "8de1adb6-676c-48db-8d77-490f7ee76c05";

// Show a thank-you state when ?sent=1 is in the URL (Web3Forms redirects here after submission)
const sent = Astro.url.searchParams.get("sent") === "1";
---

<Layout
  title="Contact | Décoration mariage Toulouse | Aritia Design"
  description="Contactez Aritia pour concevoir votre mariage ou événement sur-mesure à Toulouse, en Haute-Garonne. Réservez un premier échange pour partager votre vision."
  transparentHeader={true}
>
  <PageHero
    image="/images/contact-hero.jpg"
    imageMobile="/images/contact-hero-mobile.jpg"
    imageAlt="Plafond aux poutres, lieu de mariage Aritia Design"
    title="Contact"
    titleKey="contact.hero.title"
    subtitleHtml="Vous rêvez d'un mariage ou d'un événement <br />qui vous ressemble&nbsp;?"
    subtitleKey="contact.hero.subtitle"
  />

  {/* ───────────────────────── 2. FORM ───────────────────────── */}
  <section class="bg-white px-6 py-20 md:py-28">
    <div class="mx-auto max-w-[1200px] grid md:grid-cols-2 gap-12 md:gap-16">
      {/* left: image + NOTES — pushed below the form on mobile, Notes before image on mobile */}
      <div class="flex flex-col-reverse md:flex-col gap-8 order-2 md:order-1">
        <div class="aspect-[4/5] overflow-hidden">
          <img
            src="/images/contact-flower.jpg"
            alt="Gros plan fleurs rouges de mariage, Aritia Design"
            class="w-full h-full object-cover"
          />
        </div>
        <div class="bg-[#1a1a1a] text-white p-8 md:p-10">
          <p class="font-display tracking-[0.28em] uppercase text-[20px] md:text-[22px] text-white/65" data-i18n="contact.notes.label">Notes</p>
          <p class="mt-5 text-[14px] leading-[1.9] text-white/85" data-i18n="contact.notes.p1">
            Merci de compléter ce formulaire avec soin. Nous reviendrons
            vers vous dans les 48 heures ouvrées afin de planifier un
            premier rendez-vous téléphonique, en visio ou en
            présentiel.
          </p>
          <p class="mt-5 text-[14px] leading-[1.9] text-white/85">
            <span data-i18n="contact.notes.p2">Vous pouvez aussi nous écrire directement à l'adresse
            suivante&nbsp;:</span>
            <a
              href="mailto:contact@aritiadesign.com"
              class="block mt-2 underline underline-offset-4 hover:opacity-70 transition"
            >contact@aritiadesign.com</a>
          </p>
        </div>
      </div>

      {/* right: form — first on mobile so Envoyer appears before the photo */}
      <div class="order-1 md:order-2">
        <h2 class="font-display text-[34px] md:text-[44px] lg:text-[60px] leading-[1.05] md:leading-[1] tracking-wide text-[var(--color-ink)]" data-i18n="contact.h2">
          FAISONS<br />CONNAISSANCE
        </h2>
        <p class="mt-6 md:mt-8 text-[13px] md:text-[14px] leading-[1.85] md:leading-[1.9] text-[var(--color-ink-soft)]" data-i18n="contact.p">
          Votre projet mérite une attention toute particulière, un
          regard sensible, et une mise en scène à la hauteur de vos
          émotions. Nous avons hâte de découvrir votre histoire et
          façonner un univers qui vous ressemble. Complétez le
          formulaire ci-dessous pour planifier notre premier échange.
        </p>

        {/* Brochure lead-in — offered just above the form for hesitant visitors */}
        <p class="mt-4 md:mt-5 text-[13px] md:text-[14px] leading-[1.85] italic text-[var(--color-ink-soft)]" data-i18n="contact.brochure.lead">
          Vous souhaitez revoir nos prestations et nos tarifs au préalable ? Notre Guide des Services <span class="italic-num">2026</span> est disponible
          <a
            href="https://www.aritiadesign.com/guide/"
            target="_blank"
            rel="noopener"
            class="not-italic underline underline-offset-4 hover:text-[#630713] transition"
          >ici</a>.
        </p>

        {sent && (
          <div class="mt-10 p-6 bg-[#f7f5f1] border border-[var(--color-ink)]/10 text-[14px] leading-[1.9] text-[var(--color-ink-soft)]">
            <p class="font-display text-[20px] text-[var(--color-ink)] mb-2" data-i18n="contact.thanks.h">Merci&nbsp;!</p>
            <p data-i18n="contact.thanks.p">Votre demande a bien été envoyée. Nous revenons vers vous sous 48&nbsp;h ouvrées.</p>
          </div>
        )}

        <form
          id="f-contact"
          action="https://api.web3forms.com/submit"
          method="POST"
          novalidate
          class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-6"
        >
          <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
          <input type="hidden" name="subject" value="Nouveau message — Aritia Design" />
          <input type="hidden" name="from_name" value="Site Aritia Design" />
          <input type="hidden" name="redirect" value={new URL("/contact?sent=1", Astro.site ?? Astro.url).toString()} />
          {/* Honeypot — bots fill this, real users don't */}
          <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />
          <div class="required-field border-b border-black/15 pb-1">
            <label class="sr-only" for="f-lastname" data-i18n="contact.label.lastname">Nom</label>
            <span class="fake-placeholder" aria-hidden="true">
              <span data-i18n="contact.ph.lastname">NOM</span>
            </span>
            <input
              id="f-lastname"
              type="text"
              name="Nom"
              required
              autocomplete="family-name"
              class="w-full bg-transparent text-[13px] md:text-[14px] tracking-[0.06em] text-[var(--color-ink)] focus:outline-none py-3"
            />
          </div>
          <div class="required-field border-b border-black/15 pb-1">
            <label class="sr-only" for="f-firstname" data-i18n="contact.label.firstname">Prénom</label>
            <span class="fake-placeholder" aria-hidden="true">
              <span data-i18n="contact.ph.firstname">PRÉNOM</span>
            </span>
            <input
              id="f-firstname"
              type="text"
              name="Prénom"
              required
              autocomplete="given-name"
              class="w-full bg-transparent text-[13px] md:text-[14px] tracking-[0.06em] text-[var(--color-ink)] focus:outline-none py-3"
            />
          </div>
          <div class="required-field border-b border-black/15 pb-1">
            <label class="sr-only" for="f-email" data-i18n="contact.label.email">Email</label>
            <span class="fake-placeholder" aria-hidden="true">
              <span data-i18n="contact.ph.email">E-MAIL</span>
            </span>
            <input
              id="f-email"
              type="email"
              name="Email"
              required
              autocomplete="email"
              class="w-full bg-transparent text-[13px] md:text-[14px] tracking-[0.06em] text-[var(--color-ink)] focus:outline-none py-3"
            />
          </div>
          <div class="border-b border-black/15 pb-1 flex items-center">
            <label class="sr-only" for="f-phone" data-i18n="contact.label.phone">Téléphone</label>
            <span
              id="f-phone-prefix"
              class="flex items-center gap-2 max-w-0 opacity-0 overflow-hidden transition-all duration-200 pointer-events-none"
            >
              <select
                id="f-phone-country"
                aria-label="Indicatif pays"
                tabindex="-1"
                class="bg-transparent text-[10px] md:text-[11px] tracking-[0.15em] uppercase text-[var(--color-muted)] focus:outline-none py-3 pr-1 appearance-none cursor-pointer shrink-0"
              >
                <option value="+33" selected>FR</option>
                <option value="+32">BE</option>
                <option value="+41">CH</option>
                <option value="+352">LU</option>
                <option value="+377">MC</option>
                <option value="+44">UK</option>
                <option value="+1">US</option>
                <option value="+34">ES</option>
                <option value="+39">IT</option>
                <option value="+49">DE</option>
                <option value="+351">PT</option>
                <option value="+31">NL</option>
              </select>
              <span aria-hidden="true" class="text-[var(--color-muted)] text-[13px] md:text-[14px] shrink-0 select-none">|</span>
            </span>
            <input
              id="f-phone"
              type="tel"
              name="Téléphone"
              placeholder="TÉLÉPHONE"
              data-i18n-attr="placeholder:contact.ph.phone"
              class="flex-1 bg-transparent text-[13px] md:text-[14px] tracking-[0.06em] placeholder:text-[11px] md:placeholder:text-[12px] placeholder:tracking-[0.2em] md:placeholder:tracking-[0.22em] placeholder:uppercase placeholder-[var(--color-muted)] focus:outline-none py-3 pl-0 focus:pl-2 transition-[padding] duration-200"
            />
          </div>
          <div class="required-field date-field border-b border-black/15 pb-1 relative">
            <label class="sr-only" for="f-date" data-i18n="contact.label.date">Date</label>
            <span class="fake-placeholder" aria-hidden="true">
              <span data-i18n="contact.ph.date">DATE DE L'ÉVÉNEMENT</span>
            </span>
            <input
              id="f-date"
              type="text"
              name="Date"
              required
              readonly
              autocomplete="off"
              inputmode="none"
              class="w-full bg-transparent text-[13px] md:text-[14px] tracking-[0.06em] text-[var(--color-ink)] focus:outline-none py-3 cursor-pointer"
            />
            <div id="f-date-picker" class="date-picker" hidden>
              <div class="dp-header">
                <button type="button" class="dp-nav" data-nav="prev" aria-label="Mois précédent">‹</button>
                <span class="dp-title">
                  <select class="dp-select dp-month-select" data-dp-month aria-label="Mois"></select>
                  <select class="dp-select dp-year-select" data-dp-year aria-label="Année"></select>
                </span>
                <button type="button" class="dp-nav" data-nav="next" aria-label="Mois suivant">›</button>
              </div>
              <div class="dp-weekdays">
                <span>Lun</span><span>Mar</span><span>Mer</span><span>Jeu</span><span>Ven</span><span>Sam</span><span>Dim</span>
              </div>
              <div class="dp-days"></div>
            </div>
          </div>
          <div class="required-field border-b border-black/15 pb-1">
            <label class="sr-only" for="f-guests" data-i18n="contact.label.guests">Nombre d'invités</label>
            <span class="fake-placeholder" aria-hidden="true">
              <span data-i18n="contact.ph.guests">NOMBRE ESTIMÉ D'INVITÉS</span>
            </span>
            <input
              id="f-guests"
              type="number"
              name="Nombre d'invités"
              required
              min="1"
              inputmode="numeric"
              class="w-full bg-transparent text-[13px] md:text-[14px] tracking-[0.06em] text-[var(--color-ink)] focus:outline-none py-3"
            />
          </div>
          <div class="md:col-span-2 border-b border-black/15 pb-1">
            <label class="sr-only" for="f-location" data-i18n="contact.label.location">Lieu</label>
            <span class="fake-placeholder" aria-hidden="true">
              <span data-i18n="contact.ph.loc">LIEU DE L'ÉVÉNEMENT</span>
            </span>
            <input
              id="f-location"
              type="text"
              name="Lieu"
              autocomplete="off"
              class="w-full bg-transparent text-[13px] md:text-[14px] tracking-[0.06em] text-[var(--color-ink)] focus:outline-none py-3"
            />
            <ul id="f-location-dropdown" class="location-dropdown" role="listbox" aria-label="Suggestions d'adresses"></ul>
          </div>
          <div class="required-field border-b border-black/15 pb-1 relative">
            <label class="sr-only" for="f-type-display" data-i18n="contact.label.type">Type d'événement</label>
            <span class="fake-placeholder" aria-hidden="true">
              <span data-i18n="contact.opt.type.placeholder">TYPE D'ÉVÉNEMENT</span>
            </span>
            <input
              id="f-type-display"
              type="text"
              readonly
              autocomplete="off"
              inputmode="none"
              aria-haspopup="listbox"
              aria-expanded="false"
              class="w-full bg-transparent text-[13px] md:text-[14px] tracking-[0.06em] text-[var(--color-ink)] focus:outline-none py-3 cursor-pointer"
            />
            <select id="f-type" name="Type" required class="sr-only" tabindex="-1" aria-hidden="true">
              <option value="" disabled selected></option>
              <option value="Mariage" data-i18n="contact.opt.type.0">Mariage</option>
              <option value="Événement saisonnier" data-i18n="contact.opt.type.1">Événement saisonnier</option>
              <option value="Événements privés" data-i18n="contact.opt.type.2">Événements privés</option>
              <option value="Anniversaire" data-i18n="contact.opt.type.3">Anniversaire</option>
              <option value="Baby Shower" data-i18n="contact.opt.type.4">Baby Shower</option>
              <option value="Autre" data-i18n="contact.opt.type.5">Autre</option>
            </select>
            <ul id="f-type-dropdown" class="options-dropdown" role="listbox" aria-label="Type d'événement" hidden></ul>
          </div>
          <div class="required-field border-b border-black/15 pb-1 relative">
            <label class="sr-only" for="f-prestation-display" data-i18n="contact.label.service">Prestation</label>
            <span class="fake-placeholder" aria-hidden="true">
              <span data-i18n="contact.opt.service.placeholder">PRESTATION SOUHAITÉE</span>
            </span>
            <input
              id="f-prestation-display"
              type="text"
              readonly
              autocomplete="off"
              inputmode="none"
              aria-haspopup="listbox"
              aria-expanded="false"
              class="w-full bg-transparent text-[13px] md:text-[14px] tracking-[0.06em] text-[var(--color-ink)] focus:outline-none py-3 cursor-pointer"
            />
            <select id="f-prestation" name="Prestation" required class="sr-only" tabindex="-1" aria-hidden="true">
              <option value="" disabled selected></option>
              <option value="L'Exception — Design intégral" data-i18n="contact.opt.service.0">L'Exception — Design intégral</option>
              <option value="Pack Atmosphère — Identité visuelle" data-i18n="contact.opt.service.1">Pack Atmosphère — Identité visuelle</option>
              <option value="Direction Artistique Seule" data-i18n="contact.opt.service.2">Direction Artistique Seule</option>
              <option value="Papeterie Fine" data-i18n="contact.opt.service.3">Papeterie Fine</option>
              <option value="Conception Florale" data-i18n="contact.opt.service.4">Conception Florale</option>
              <option value="Décor &amp; Scénographie" data-i18n="contact.opt.service.5">Décor &amp; Scénographie</option>
              <option value="Sur-mesure" data-i18n="contact.opt.service.6">Sur-mesure</option>
            </select>
            <ul id="f-prestation-dropdown" class="options-dropdown" role="listbox" aria-label="Prestation souhaitée" hidden></ul>
          </div>
          <div class="required-field md:col-span-2 border-b border-black/15 pb-1">
            <label class="sr-only" for="f-desc" data-i18n="contact.label.desc">Détails complémentaires</label>
            <span class="fake-placeholder" aria-hidden="true">
              <span data-i18n="contact.ph.desc">DÉTAILS COMPLÉMENTAIRES</span>
            </span>
            <textarea
              id="f-desc"
              name="Détails complémentaires"
              rows="4"
              class="w-full bg-transparent text-[14px] tracking-[0.06em] text-[var(--color-ink)] focus:outline-none py-3 resize-none"
            ></textarea>
          </div>

          <!-- Consentement RGPD : obligatoire pour conformite legale -->
          <div class="consent-field md:col-span-2 pt-2 flex items-start gap-3">
            <input
              id="f-consent"
              type="checkbox"
              name="Consentement RGPD"
              value="Oui"
              required
              class="consent-checkbox mt-[3px] w-[16px] h-[16px] flex-shrink-0 cursor-pointer"
            />
            <label
              for="f-consent"
              data-i18n="contact.consent.label"
              class="text-[11px] md:text-[11.5px] leading-[1.5] text-[var(--color-muted)] tracking-[0.02em] cursor-pointer"
            >
              J'accepte que mes données personnelles soient traitées par Aritia Design dans le cadre du suivi de ma demande, conformément à la <a href="/politique-confidentialite" class="underline underline-offset-4 hover:opacity-70">politique de confidentialité</a>.
            </label>
          </div>

          <div class="submit-btn-wrap md:col-span-2 pt-4 text-center">
            <button
              type="submit"
              disabled={sent}
              aria-label="Envoyer"
              class="submit-btn text-[var(--color-ink)] hover:opacity-70 transition disabled:hover:opacity-100 disabled:cursor-default inline-flex items-center justify-center"
            >
              {sent ? (
                <span class="font-script text-[40px] md:text-[50px] inline-block text-left leading-[0.95] rotate-[-11deg] origin-center">
                  <span class="block">Bien reçu,</span>
                  <span class="block pl-[0.9em]">à très vite&nbsp;!</span>
                </span>
              ) : (
                <svg
                  class="submit-btn-svg"
                  viewBox="0 0 1921.5 652.83"
                  fill="currentColor"
                  aria-hidden="true"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <g>
