---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";

// Web3Forms access key — get yours at https://web3forms.com (free, unlimited)
const WEB3FORMS_KEY = "8de1adb6-676c-48db-8d77-490f7ee76c05";

// Show a thank-you state when ?sent=1 is in the URL (Web3Forms redirects here after submission)
const sent = Astro.url.searchParams.get("sent") === "1";
---

<Layout
  title="Contact | Décoration mariage Toulouse | Aritia Design"
  description="Contactez Aritia pour concevoir votre mariage ou événement sur-mesure à Toulouse, en Haute-Garonne. Réservez un premier échange pour partager votre vision."
  transparentHeader={true}
>
  <PageHero
    image="/images/contact-hero.jpg"
    imageMobile="/images/contact-hero-mobile.jpg"
    imageAlt="Plafond aux poutres, lieu de mariage Aritia Design"
    title="Contact"
    titleKey="contact.hero.title"
    subtitleHtml="Vous rêvez d'un mariage ou d'un événement <br />qui vous ressemble&nbsp;?"
    subtitleKey="contact.hero.subtitle"
  />

  {/* ───────────────────────── 2. FORM ───────────────────────── */}
  <section class="bg-white px-6 py-20 md:py-28">
    <div class="mx-auto max-w-[1200px] grid md:grid-cols-2 gap-12 md:gap-16">
      {/* left: image + NOTES — pushed below the form on mobile, Notes before image on mobile */}
      <div class="flex flex-col-reverse md:flex-col gap-8 order-2 md:order-1">
        <div class="aspect-[4/5] overflow-hidden">
          <img
            src="/images/contact-flower.jpg"
            alt="Gros plan fleurs rouges de mariage, Aritia Design"
            class="w-full h-full object-cover"
          />
        </div>
        <div class="bg-[#1a1a1a] text-white p-8 md:p-10">
          <p class="font-display tracking-[0.28em] uppercase text-[20px] md:text-[22px] text-white/65" data-i18n="contact.notes.label">Notes</p>
          <p class="mt-5 text-[14px] leading-[1.9] text-white/85" data-i18n="contact.notes.p1">
            Merci de remplir ce formulaire avec soin. Je reviendrai
            vers vous dans les 48 heures ouvrées afin de planifier un
            premier rendez-vous téléphonique, en visio ou en
            présentiel.
          </p>
          <p class="mt-5 text-[14px] leading-[1.9] text-white/85">
            <span data-i18n="contact.notes.p2">Vous pouvez aussi nous écrire directement à l'adresse
            suivante&nbsp;:</span>
            <a
              href="mailto:contact@aritiadesign.com"
              class="block mt-2 underline underline-offset-4 hover:opacity-70 transition"
            >contact@aritiadesign.com</a>
          </p>
          <p class="mt-6 pt-6 border-t border-white/15 text-[13px] leading-[1.8] text-white/75" data-i18n="contact.notes.brochure">
            <span class="italic">En attendant, explorez notre</span>
            <a
              href="/brochure/"
              target="_blank"
              rel="noopener"
              class="underline underline-offset-4 hover:opacity-70 transition"
            >guide de services</a>.
          </p>
        </div>
      </div>

      {/* right: form — first on mobile so Envoyer appears before the photo */}
      <div class="order-1 md:order-2">
        <h2 class="font-display text-[34px] md:text-[44px] lg:text-[60px] leading-[1.05] md:leading-[1] tracking-wide text-[var(--color-ink)]" data-i18n="contact.h2">
          FAISONS<br />CONNAISSANCE
        </h2>
        <p class="mt-6 md:mt-8 text-[13px] md:text-[14px] leading-[1.85] md:leading-[1.9] text-[var(--color-ink-soft)] max-w-md" data-i18n="contact.p">
          Votre histoire mérite une attention toute particulière, un
          regard sensible, et une mise en scène à la hauteur de vos
          émotions. Je serais honorée de vous accompagner dans la
          création d'un univers qui vous ressemble.
        </p>

        {sent && (
          <div class="mt-10 p-6 bg-[#f7f5f1] border border-[var(--color-ink)]/10 text-[14px] leading-[1.9] text-[var(--color-ink-soft)]">
            <p class="font-display text-[20px] text-[var(--color-ink)] mb-2" data-i18n="contact.thanks.h">Merci&nbsp;!</p>
            <p data-i18n="contact.thanks.p">Votre demande a bien été envoyée. Je reviens vers vous sous 48&nbsp;h ouvrées.</p>
          </div>
        )}

        <form
          action="https://api.web3forms.com/submit"
          method="POST"
          class="mt-10 space-y-7"
        >
          <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
          <input type="hidden" name="subject" value="Nouveau message — Aritia Design" />
          <input type="hidden" name="from_name" value="Site Aritia Design" />
          <input type="hidden" name="redirect" value={new URL("/contact?sent=1", Astro.site ?? Astro.url).toString()} />
          {/* Honeypot — bots fill this, real users don't */}
          <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />
          <div class="border-b border-black/15 pb-1">
            <label class="sr-only" for="f-name" data-i18n="contact.label.name">Nom &amp; Prénom</label>
            <input
              id="f-name"
              type="text"
              name="Nom & Prénom"
              required
              placeholder="NOM & PRÉNOM *"
              data-i18n-attr="placeholder:contact.ph.name"
              class="w-full bg-transparent text-[13px] md:text-[14px] tracking-[0.02em] placeholder:text-[11px] md:placeholder:text-[12px] placeholder:tracking-[0.2em] md:placeholder:tracking-[0.22em] placeholder:uppercase placeholder-[var(--color-muted)] focus:outline-none py-3"
            />
          </div>
          <div class="border-b border-black/15 pb-1">
            <label class="sr-only" for="f-email" data-i18n="contact.label.email">Email</label>
            <input
              id="f-email"
              type="email"
              name="Email"
              required
              placeholder="E-MAIL *"
              data-i18n-attr="placeholder:contact.ph.email"
              class="w-full bg-transparent text-[13px] md:text-[14px] tracking-[0.02em] placeholder:text-[11px] md:placeholder:text-[12px] placeholder:tracking-[0.2em] md:placeholder:tracking-[0.22em] placeholder:uppercase placeholder-[var(--color-muted)] focus:outline-none py-3"
            />
          </div>
          <div class="border-b border-black/15 pb-1 flex items-center">
            <label class="sr-only" for="f-phone" data-i18n="contact.label.phone">Téléphone</label>
            <span
              id="f-phone-prefix"
              class="flex items-center gap-2 max-w-0 opacity-0 overflow-hidden transition-all duration-200 pointer-events-none"
            >
              <select
                id="f-phone-country"
                aria-label="Indicatif pays"
                tabindex="-1"
                class="bg-transparent text-[10px] md:text-[11px] tracking-[0.15em] uppercase text-[var(--color-muted)] focus:outline-none py-3 pr-1 appearance-none cursor-pointer shrink-0"
              >
                <option value="+33" selected>FR</option>
                <option value="+32">BE</option>
                <option value="+41">CH</option>
                <option value="+352">LU</option>
                <option value="+377">MC</option>
                <option value="+44">UK</option>
                <option value="+1">US</option>
                <option value="+34">ES</option>
                <option value="+39">IT</option>
                <option value="+49">DE</option>
                <option value="+351">PT</option>
                <option value="+31">NL</option>
              </select>
              <span aria-hidden="true" class="text-[var(--color-muted)] text-[13px] md:text-[14px] shrink-0 select-none">|</span>
            </span>
            <input
              id="f-phone"
              type="tel"
              name="Téléphone"
              placeholder="TÉLÉPHONE"
              data-i18n-attr="placeholder:contact.ph.phone"
              class="flex-1 bg-transparent text-[13px] md:text-[14px] tracking-[0.02em] placeholder:text-[11px] md:placeholder:text-[12px] placeholder:tracking-[0.2em] md:placeholder:tracking-[0.22em] placeholder:uppercase placeholder-[var(--color-muted)] focus:outline-none py-3 pl-0 focus:pl-2 transition-[padding] duration-200"
            />
          </div>
          <div class="border-b border-black/15 pb-1">
            <label class="sr-only" for="f-date" data-i18n="contact.label.date">Date</label>
            <input
              id="f-date"
              type="text"
              name="Date"
              required
              placeholder="DATE DE L'ÉVÉNEMENT *"
              data-i18n-attr="placeholder:contact.ph.date"
              onfocus="(this.type='date');this.showPicker&&this.showPicker()"
              onblur="if(!this.value)this.type='text'"
              class="w-full bg-transparent text-[13px] md:text-[14px] tracking-[0.02em] placeholder:text-[11px] md:placeholder:text-[12px] placeholder:tracking-[0.2em] md:placeholder:tracking-[0.22em] placeholder:uppercase placeholder-[var(--color-muted)] focus:outline-none py-3"
            />
          </div>
          <div class="border-b border-black/15 pb-1">
            <label class="sr-only" for="f-location" data-i18n="contact.label.location">Lieu</label>
            <input
              id="f-location"
              type="text"
              name="Lieu"
              required
              placeholder="LIEU DE L'ÉVÉNEMENT *"
              data-i18n-attr="placeholder:contact.ph.loc"
              class="w-full bg-transparent text-[13px] md:text-[14px] tracking-[0.02em] placeholder:text-[11px] md:placeholder:text-[12px] placeholder:tracking-[0.2em] md:placeholder:tracking-[0.22em] placeholder:uppercase placeholder-[var(--color-muted)] focus:outline-none py-3"
            />
          </div>
          <div class="border-b border-black/15 pb-1">
            <label class="sr-only" for="f-prestation" data-i18n="contact.label.service">Prestation</label>
            <select
              id="f-prestation"
              name="Prestation"
              required
              class="w-full bg-transparent text-[11px] md:text-[12px] tracking-[0.2em] md:tracking-[0.22em] uppercase text-[var(--color-muted)] focus:outline-none py-3 appearance-none"
            >
              <option value="" disabled selected data-i18n="contact.opt.service.placeholder">PRESTATION SOUHAITÉE *</option>
              <option style="letter-spacing:0.15em" data-i18n="contact.opt.service.0">L'Exception — Design intégral</option>
              <option style="letter-spacing:0.15em" data-i18n="contact.opt.service.1">Pack Atmosphère — Identité visuelle</option>
              <option style="letter-spacing:0.15em" data-i18n="contact.opt.service.2">Direction Artistique Seule</option>
              <option style="letter-spacing:0.15em" data-i18n="contact.opt.service.3">Papeterie Fine</option>
              <option style="letter-spacing:0.15em" data-i18n="contact.opt.service.4">Conception Florale</option>
              <option style="letter-spacing:0.15em" data-i18n="contact.opt.service.5">Décor &amp; Scénographie</option>
            </select>
          </div>
          <div class="border-b border-black/15 pb-1">
            <label class="sr-only" for="f-type" data-i18n="contact.label.type">Type d'événement</label>
            <select
              id="f-type"
              name="Type"
              required
              class="w-full bg-transparent text-[11px] md:text-[12px] tracking-[0.2em] md:tracking-[0.22em] uppercase text-[var(--color-muted)] focus:outline-none py-3 appearance-none"
            >
              <option value="" disabled selected data-i18n="contact.opt.type.placeholder">TYPE D'ÉVÉNEMENT *</option>
              <option style="letter-spacing:0.15em" data-i18n="contact.opt.type.0">Mariage</option>
              <option style="letter-spacing:0.15em" data-i18n="contact.opt.type.1">Événement saisonnier</option>
              <option style="letter-spacing:0.15em" data-i18n="contact.opt.type.2">Anniversaire</option>
              <option style="letter-spacing:0.15em" data-i18n="contact.opt.type.3">Baby Shower</option>
              <option style="letter-spacing:0.15em" data-i18n="contact.opt.type.4">Événement Corporate</option>
              <option style="letter-spacing:0.15em" data-i18n="contact.opt.type.5">Autre</option>
            </select>
          </div>
          <div class="border-b border-black/15 pb-1">
            <label class="sr-only" for="f-budget" data-i18n="contact.label.budget">Budget</label>
            <input
              id="f-budget"
              type="text"
              name="Budget"
              required
              placeholder="BUDGET ENVISAGÉ POUR VOTRE PROJET *"
              data-i18n-attr="placeholder:contact.ph.budget"
              class="w-full bg-transparent text-[13px] md:text-[14px] tracking-[0.02em] placeholder:text-[11px] md:placeholder:text-[12px] placeholder:tracking-[0.2em] md:placeholder:tracking-[0.22em] placeholder:uppercase placeholder-[var(--color-muted)] focus:outline-none py-3"
            />
          </div>
          <div class="border-b border-black/15 pb-1">
            <label class="sr-only" for="f-desc" data-i18n="contact.label.desc">Description</label>
            <textarea
              id="f-desc"
              name="Description"
              required
              rows="4"
              placeholder="DESCRIPTION *"
              data-i18n-attr="placeholder:contact.ph.desc"
              class="w-full bg-transparent text-[14px] tracking-[0.02em] placeholder:text-[12px] placeholder:tracking-[0.22em] placeholder:uppercase placeholder-[var(--color-muted)] focus:outline-none py-3 resize-none"
            ></textarea>
          </div>

          <div class="pt-4 text-center">
            <button
              type="submit"
              class="font-script text-[34px] md:text-[42px] text-[var(--color-ink)] hover:opacity-70 transition leading-none"
              data-i18n="contact.submit"
            >
              Envoyer
            </button>
          </div>
        </form>
      </div>
    </div>
  </section>

  <script is:inline>
    /* Phone field — country selector prefills / rewrites the dial code prefix.
       The FR selector + "|" separator stay hidden until the input is focused
       or already has a value; on focus, if empty, prepend the selected dial
       code (e.g. "+33 "). On country change, swap the existing prefix for the
       new one, preserving the rest of the number the user typed. */
    (function () {
      var sel = document.getElementById("f-phone-country");
      var inp = document.getElementById("f-phone");
      var prefix = document.getElementById("f-phone-prefix");
      if (!sel || !inp || !prefix) return;

      function dial() { return sel.value; }
      function stripDial(v) {
        var m = v.match(/^\+\d+\s*(.*)$/);
        return m ? m[1] : v;
      }
      function showPrefix() {
        prefix.style.maxWidth = "120px";
        prefix.style.opacity = "1";
        prefix.style.pointerEvents = "auto";
      }
      function hidePrefix() {
        prefix.style.maxWidth = "0";
        prefix.style.opacity = "0";
        prefix.style.pointerEvents = "none";
      }

      inp.addEventListener("focus", function () {
        showPrefix();
        if (!this.value.trim()) this.value = dial() + " ";
      });

      inp.addEventListener("blur", function () {
        if (this.value.trim() === dial() || !this.value.trim()) {
          this.value = "";
          hidePrefix();
        }
      });

      sel.addEventListener("change", function () {
        var rest = stripDial(inp.value.trim());
        inp.value = (dial() + " " + rest).trim();
        inp.focus();
      });
    })();
  </script>
</Layout>
