---
import Layout from "../../layouts/Layout.astro";
import { projects, type Project } from "../../data/projects";

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

interface Props { project: Project }
const { project: p } = Astro.props;

// Per-project override of the 3rd and 4th footer images
const footerImage3 = p.slug === "hj"
  ? { src: "/images/footer-hj-3.jpg", alt: "Table rectangulaire avec roses blanches — H+J" }
  : undefined;
const footerImage4 = p.slug === "hj"
  ? { src: "/images/footer-hj-4.jpg", alt: "Bouquet de callas blancs — H+J" }
  : undefined;
---

<Layout
  title={`${p.title} ${p.titleItalic} | ${p.subtitle} | Aritia Design`}
  description={`Décoration de mariage haut de gamme par Aritia Design. ${p.intro.slice(0, 100)}...`}
  transparentHeader={false}
  footerImage3={footerImage3}
  footerImage4={footerImage4}
>
  {/* ───────────────────────── 1. HERO — 3-PHOTO ROW ───────────────────────── */}
  <section class="bg-white px-2 md:px-14 pt-32 md:pt-40 pb-12">
    <div class="mx-auto max-w-[1240px] grid grid-cols-[1fr_1.25fr_1fr] gap-2 md:gap-12 items-center">
      {p.gallery.slice(0, 3).map((src, i) => (
        <div class="aspect-[3/4] overflow-hidden">
          <img
            src={src}
            alt={`${p.title} — preview ${i + 1}`}
            class="w-full h-full object-cover"
          />
        </div>
      ))}
    </div>
  </section>

  {/* ───────────────────────── 2. TITLE + INTRO + CREDITS (centered) ───────────────────────── */}
  <section class="bg-white px-6 py-16 md:py-24 text-center">
    <div class="mx-auto max-w-[820px]">
      <h1 class="font-display font-normal text-[36px] md:text-[56px] leading-[1.1]">
        {p.title}<br />
        <span class="font-italic-serif italic font-light">{p.titleItalic}</span>
      </h1>
      <p class="mt-6 text-[11px] tracking-[0.32em] uppercase text-[var(--color-muted)]">
        {p.subtitle}
      </p>

      <p class="mt-12 text-[16px] leading-[1.9] text-[var(--color-ink-soft)] text-center">
        {p.intro}
      </p>

      <dl class="mt-12 space-y-1 text-[16px] leading-[1.7] text-[var(--color-ink-soft)] text-center">
        {p.credits.map((c) => (
          <div>
            {c.label && <><dt class="inline font-medium">{c.label}&nbsp;:</dt>{" "}</>}
            <dd class="inline" set:html={c.value} />
          </div>
        ))}
      </dl>
    </div>
  </section>

  {/* ───────────────────────── 2b. PARALLAX BREAK (optional) ───────────────────────── */}
  {p.parallax && (
    <section
      class="project-parallax"
      aria-label={`${p.title} — vue d'ensemble`}
    >
      <div
        class="project-parallax-bg"
        style={`background-image: url('${p.parallax}');`}
      ></div>
    </section>
  )}

  <style>
    /* Parallax fluide : wrapper clip overflow + enfant translaté via JS.
       Transform GPU = pas de saccade. L'image est plus haute que le wrapper
       pour avoir de la marge de déplacement. */
    .project-parallax {
      position: relative;
      height: 400px;
      overflow: hidden;
    }
    .project-parallax-bg {
      position: absolute;
      top: -30%;
      left: 0;
      width: 100%;
      height: 160%;
      background-size: cover;
      background-position: center;
      will-change: transform;
    }
    @media (max-width: 767px) {
      .project-parallax { height: 220px; }
      .project-parallax-bg {
        /* Pas de parallax sur mobile : image fixe dans son wrapper */
        top: 0;
        height: 100%;
        will-change: auto;
      }
    }
  </style>

  <script is:inline>
    /* Parallax JS fluide : translation GPU en fonction du scroll.
       requestAnimationFrame pour synchroniser avec le refresh rate. */
    (function () {
      if (window.matchMedia("(max-width: 767px)").matches) return;
      const el = document.querySelector(".project-parallax");
      if (!el) return;
      const bg = el.querySelector(".project-parallax-bg");
      if (!bg) return;

      let ticking = false;
      function update() {
        const rect = el.getBoundingClientRect();
        const vh = window.innerHeight;
        // Progression: 0 quand la section commence à sortir par le haut,
        // 1 quand elle commence à entrer par le bas
        const progress = (vh - rect.top) / (vh + rect.height);
        // Marge de 30% haut/bas sur l'image : on peut déplacer de -30% à +30%
        const translatePct = (progress - 0.5) * 60;
        bg.style.transform = `translate3d(0, ${translatePct}%, 0)`;
        ticking = false;
      }
      function onScroll() {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      }
      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll, { passive: true });
      update();
    })();
  </script>

  {/* ───────────────────────── 3. SECTIONS (chapters + photo grids) ───────────────────────── */}
  {p.sections?.map((s) => {
    const isDark = s.bg === "dark";
    // Soit left/right explicites, soit split auto depuis images (even=L, odd=R)
    const leftImages = s.left ?? s.images?.filter((_, i) => i % 2 === 0) ?? [];
    const rightImages = s.right ?? s.images?.filter((_, i) => i % 2 === 1) ?? [];
    return (
      <section class:list={[isDark ? "bg-[#1a1a1a] text-white" : "bg-white text-[var(--color-ink-soft)]"]}>
        <div class="px-6 pt-20 md:pt-28 pb-10 md:pb-14 text-center">
          <div class:list={[
            "inline-block text-[11px] tracking-[0.32em] uppercase",
            isDark ? "text-white py-3" : "bg-[#1a1a1a] text-white px-8 py-3",
          ]}>
            ✦ {s.label} ✦
          </div>
          {s.motif && (
            <div class="mt-8 md:mt-10 flex justify-center">
              <img
                src={s.motif}
                alt=""
                aria-hidden="true"
                class:list={[
                  "h-[140px] md:h-[200px] w-auto opacity-70",
                  isDark ? "invert" : "",
                ]}
              />
            </div>
          )}
        </div>
        {s.text && (
          <div class="px-6 pb-12 md:pb-16 text-center">
            <p class:list={[
              "mx-auto max-w-[720px] italic",
              isDark ? "text-white/85" : "text-[var(--color-ink-soft)]",
            ]}>
              {s.text}
            </p>
          </div>
        )}
        <div class="px-2 md:px-14 pb-20 md:pb-28">
          {/* Mosaïque masonry : chaque colonne empile ses photos indépendamment.
              Gaps horizontal (entre colonnes) et vertical (entre photos d'une
              même colonne) identiques : gap-2 mobile / gap-10 desktop (40px).
              Les photos gardent leurs hauteurs naturelles, effet tuile. */}
          <div class="mx-auto max-w-[1100px] grid grid-cols-2 gap-2 md:gap-10 items-start">
            <div class="flex flex-col gap-2 md:gap-10">
              {leftImages.map((src, i) => (
                <div class="block overflow-hidden bg-neutral-200">
                  <img
                    src={src}
                    alt={`${p.title} — ${s.label} #L${i + 1}`}
                    loading="lazy"
                    class="block w-full h-auto"
                  />
                </div>
              ))}
            </div>
            <div class="flex flex-col gap-2 md:gap-10">
              {rightImages.map((src, i) => (
                <div class="block overflow-hidden bg-neutral-200">
                  <img
                    src={src}
                    alt={`${p.title} — ${s.label} #R${i + 1}`}
                    loading="lazy"
                    class="block w-full h-auto"
                  />
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>
    );
  })}

  {/* ───────────────────────── 3b. OUTRO VIDEO (optional) ───────────────────────── */}
  {p.outroVideo && (
    <section class="bg-white px-6 md:px-14 pb-20 md:pb-28">
      <div class="mx-auto max-w-[1200px] aspect-video overflow-hidden bg-black">
        <video
          src={p.outroVideo}
          autoplay
          muted
          loop
          playsinline
          preload="auto"
          class="w-full h-full object-cover"
        ></video>
      </div>
    </section>
  )}

  {/* ───────────────────────── 3.5 MOMENT D'EXCEPTION (highlight video) ───────────────────────── */}
  {p.momentVideo && (
    <section class="bg-white px-6 py-20 md:py-28 text-center">
      <h2 class="font-display text-[36px] md:text-[44px] lg:text-[52px] leading-[1.2]" data-i18n="project.moment.h2">
        UN MOMENT D'EXCEPTION&nbsp;!<br />
        <span class="font-italic-serif italic text-[0.7em]">décor, mise en ambiance, papeterie, floral</span>
      </h2>
      <div class="mt-12 md:mt-16 mx-auto max-w-[1100px]">
        <video
          class="block w-full aspect-video bg-black"
          src={p.momentVideo}
          controls
          playsinline
          preload="metadata"
          poster={p.hero}
        ></video>
      </div>
    </section>
  )}

  {/* ───────────────────────── 4. BACK CTA ───────────────────────── */}
  <section class="bg-white px-6 py-16 text-center">
    <a
      href="/portfolio"
      class="inline-block px-10 py-4 border border-[var(--color-ink)] text-[12px] tracking-[0.32em] uppercase hover:bg-[var(--color-ink)] hover:text-white transition"
      data-i18n="project.back"
    >
      ← Tous les projets
    </a>
  </section>
</Layout>
